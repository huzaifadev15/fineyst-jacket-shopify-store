{%- style -%}
  .cart-main {
    padding: 12rem 0 8rem;
  }

  .cart-main__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .cart-main__title {
    font-size: clamp(3rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .cart-empty {
    text-align: center;
    padding: 6rem 0;
  }

  .cart-empty__text {
    font-size: 1.8rem;
    color: #666;
    margin-bottom: 3rem;
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 40rem;
    gap: 4rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cart-item-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 2rem;
    position: relative;
    display: flex;
    gap: 2rem;
  }

  .cart-item-card__image-wrapper {
    position: relative;
    width: 15rem;
    height: 18rem;
    flex-shrink: 0;
    background: #f5f5f5;
    border-radius: 4px;
    overflow: hidden;
  }

  .cart-item-card__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-card__wishlist {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 3.5rem;
    height: 3.5rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    z-index: 10;
  }

  .cart-item-card__wishlist svg {
    width: 20px;
    height: 20px;
    stroke: #000;
    fill: none;
  }

  .cart-item-card__wishlist.is-active svg {
    fill: #000;
  }

  .cart-item-card__remove {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 3.5rem;
    height: 3.5rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    z-index: 10;
  }

  .cart-item-card__remove svg {
    width: 18px;
    height: 18px;
    stroke: #666;
  }

  .cart-item-card__remove:hover {
    background: #f5f5f5;
  }

  .cart-item-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cart-item-card__title {
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .cart-item-card__title a {
    color: #000;
    text-decoration: none;
  }

  .cart-item-card__title a:hover {
    color: #666;
  }

  .cart-item-card__details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 1.4rem;
    color: #666;
  }

  .cart-item-card__detail {
    display: flex;
    gap: 0.5rem;
  }

  .cart-item-card__detail-label {
    font-weight: 500;
  }

  .cart-item-card__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cart-quantity {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 4px;
    width: fit-content;
    background: #fff;
  }

  .cart-quantity__btn {
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #000;
    transition: background 0.2s ease;
  }

  .cart-quantity__btn:hover:not(:disabled) {
    background: #f5f5f5;
  }

  .cart-quantity__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .cart-quantity__input {
    width: 5rem;
    height: 4rem;
    text-align: center;
    border: none;
    border-left: 1px solid #ddd;
    border-right: 1px solid #ddd;
    font-size: 1.5rem;
    background: transparent;
  }

  .cart-item-card__total {
    font-size: 1.8rem;
    font-weight: 700;
    color: #000;
  }

  .cart-continue {
    margin-top: 2rem;
    display: inline-block;
    font-size: 1.4rem;
    color: #666;
    text-decoration: none;
  }

  .cart-continue:hover {
    color: #000;
  }

  .cart-promotion {
    background: #000;
    color: #fff;
    padding: 2rem;
    border-radius: 8px;
    margin-top: 3rem;
    text-align: center;
  }

  .cart-promotion__text {
    font-size: 1.6rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .cart-promotion__button {
    background: transparent;
    border: 1px solid #fff;
    color: #fff;
    padding: 1rem 2rem;
    font-size: 1.4rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .cart-promotion__button:hover {
    background: #fff;
    color: #000;
  }

  .cart-summary {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 3rem;
    position: sticky;
    top: 12rem;
    height: fit-content;
  }

  .cart-summary__title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2rem;
    text-transform: uppercase;
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .cart-summary__row-label {
    color: #666;
  }

  .cart-summary__row-value {
    font-weight: 600;
    color: #000;
  }

  .cart-summary__row--total {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e5e5;
    font-size: 2rem;
    font-weight: 700;
  }

  .cart-summary__delivery {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.5rem;
    background: #f8f8f8;
    border-radius: 4px;
    font-size: 1.4rem;
  }

  .cart-summary__delivery svg {
    width: 2rem;
    height: 2rem;
    stroke: #666;
  }

  .cart-summary__voucher {
    margin: 2rem 0;
  }

  .cart-summary__voucher-input {
    width: 100%;
    padding: 1.2rem 1.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1.4rem;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-summary__voucher-input input {
    border: none;
    background: transparent;
    flex: 1;
    font-size: 1.4rem;
    outline: none;
  }

  .cart-summary__voucher-input svg {
    width: 2rem;
    height: 2rem;
    stroke: #666;
    cursor: pointer;
  }

  .cart-summary__payment-link {
    display: block;
    margin: 1.5rem 0;
    font-size: 1.3rem;
    color: #666;
    text-decoration: underline;
    cursor: pointer;
  }

  .cart-summary__checkout {
    width: 100%;
    margin-top: 2rem;
    padding: 1.8rem;
    background: #000;
    color: #fff;
    border: none;
    font-size: 1.6rem;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 4px;
    transition: opacity 0.3s ease;
  }

  .cart-summary__checkout:hover {
    opacity: 0.9;
  }

  .cart-summary__express {
    margin-top: 2rem;
    text-align: center;
  }

  .cart-summary__express-label {
    font-size: 1.3rem;
    color: #666;
    margin-bottom: 1rem;
    display: block;
  }

  .cart-summary__express-button {
    width: 100%;
    padding: 1.2rem;
    background: #00a859;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .cart-summary__legal {
    margin-top: 2rem;
    font-size: 1.1rem;
    color: #999;
    line-height: 1.6;
  }

  .cart-summary__legal a {
    color: #666;
    text-decoration: underline;
  }

  .cart-summary__policies {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-summary__policy {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.3rem;
    color: #666;
  }

  .cart-summary__policy svg {
    width: 2rem;
    height: 2rem;
    stroke: #666;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .cart-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .cart-summary {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .cart-main {
      padding: 8rem 0 4rem;
    }

    .cart-item-card {
      flex-direction: column;
    }

    .cart-item-card__image-wrapper {
      width: 100%;
      height: 25rem;
    }

    .cart-item-card__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .cart-summary {
      padding: 2rem;
    }
  }
{%- endstyle -%}

<section class="cart-main">
  <div class="container">
    <header class="cart-main__header">
      <h1 class="cart-main__title">Your Shopping Cart</h1>
    </header>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" data-cart-form>
        <div class="cart-layout">
          <!-- Left Column: Cart Items -->
          <div class="cart-items">
            {%- for item in cart.items -%}
              <div class="cart-item-card" data-cart-item="{{ item.key }}">
                <div class="cart-item-card__image-wrapper">
                  {%- if item.image != blank -%}
                    <a href="{{ item.url }}">
                      <img 
                        src="{{ item.image | image_url: width: 300 }}" 
                        alt="{{ item.title }}" 
                        loading="lazy"
                        width="300"
                        height="360"
                      >
                    </a>
                  {%- endif -%}
                  
                  <!-- Wishlist Button -->
                  <button type="button" class="cart-item-card__wishlist" data-wishlist-add="{{ item.product.id }}" aria-label="Add to wishlist">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                  </button>

                  <!-- Remove Button -->
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item-card__remove" aria-label="Remove item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </a>
                </div>

                <div class="cart-item-card__content">
                  <div>
                    <h3 class="cart-item-card__title">
                      <a href="{{ item.url }}">{{ item.product.title | upcase }}</a>
                    </h3>
                    
                    <div class="cart-item-card__details">
                      {%- for option in item.options_with_values -%}
                        <div class="cart-item-card__detail">
                          <span class="cart-item-card__detail-label">{{ option.name }}:</span>
                          <span>{{ option.value }}</span>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>

                  <div class="cart-item-card__bottom">
                    <div class="cart-quantity">
                      <button 
                        type="button" 
                        class="cart-quantity__btn" 
                        data-quantity-minus
                        data-key="{{ item.key }}"
                        aria-label="Decrease quantity"
                      >−</button>
                      <input 
                        type="number" 
                        class="cart-quantity__input"
                        name="updates[{{ item.key }}]" 
                        value="{{ item.quantity }}" 
                        min="1"
                        data-quantity-input
                        aria-label="Quantity"
                      >
                      <button 
                        type="button" 
                        class="cart-quantity__btn" 
                        data-quantity-plus
                        data-key="{{ item.key }}"
                        aria-label="Increase quantity"
                      >+</button>
                    </div>
                    <span class="cart-item-card__total">{{ item.line_price | money }}</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}

            <a href="{{ routes.all_products_collection_url }}" class="cart-continue">
              ← Continue Shopping
            </a>

            <!-- Promotion Banner -->
            {%- if cart.item_count == 1 -%}
              <div class="cart-promotion">
                <p class="cart-promotion__text">Add one more item to your cart and get 10% off your entire order!</p>
                <button type="button" class="cart-promotion__button" onclick="window.location.href='{{ routes.all_products_collection_url }}'">
                  Discover More
                </button>
              </div>
            {%- endif -%}
          </div>

          <!-- Right Column: Order Summary -->
          <div class="cart-summary">
            <h2 class="cart-summary__title">Order Summary</h2>

            <div class="cart-summary__row">
              <span class="cart-summary__row-label">Subtotal</span>
              <span class="cart-summary__row-value">{{ cart.total_price | money }}</span>
            </div>

            <div class="cart-summary__row">
              <span class="cart-summary__row-label">Shipping</span>
              <span class="cart-summary__row-value">Free</span>
            </div>

            <div class="cart-summary__row">
              <span class="cart-summary__row-label">Estimated Tax</span>
              <span class="cart-summary__row-value">{{ 0 | money }}</span>
            </div>

            <div class="cart-summary__row cart-summary__row--total">
              <span>Total price</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <div class="cart-summary__delivery">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Delivery approx. January 03 - January 04</span>
            </div>

            <div class="cart-summary__voucher">
              <div class="cart-summary__voucher-input">
                <input type="text" placeholder="Redeem a voucher code" />
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>

            <a href="#" class="cart-summary__payment-link">Click to see what payment options are available.</a>

            <button type="submit" name="checkout" class="cart-summary__checkout">
              CHECKOUT
            </button>

            <div class="cart-summary__express">
              <span class="cart-summary__express-label">Express checkout options</span>
              <button type="button" class="cart-summary__express-button">
                Pay with <span style="font-weight: 400;">link</span>
              </button>
            </div>

            <div class="cart-summary__legal">
              The General Terms and Conditions apply. The data protection regulations can be called up <a href="/pages/privacy-policy">here</a>.
            </div>

            <div class="cart-summary__policies">
              <div class="cart-summary__policy">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
                <span>Free Shipping with in Pakistan</span>
              </div>
              <div class="cart-summary__policy">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                  <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
                <span>30 Days Free Return Policy</span>
              </div>
            </div>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <p class="cart-empty__text">Your cart is currently empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">
          Start Shopping
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function() {
  // Initialize wishlist buttons
  const wishlistButtons = document.querySelectorAll('.cart-item-card__wishlist');
  wishlistButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const productId = this.getAttribute('data-wishlist-add');
      if (productId && typeof window.addToWishlist === 'function') {
        window.addToWishlist(productId);
        this.classList.toggle('is-active');
      }
    });
  });

  // Quantity update handlers
  const quantityButtons = document.querySelectorAll('[data-quantity-minus], [data-quantity-plus]');
  quantityButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const key = this.getAttribute('data-key');
      const input = document.querySelector(`input[name="updates[${key}]"]`);
      if (!input) return;

      let currentValue = parseInt(input.value) || 1;
      if (this.hasAttribute('data-quantity-minus')) {
        if (currentValue > 1) {
          input.value = currentValue - 1;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      } else {
        input.value = currentValue + 1;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  });

  // Auto-submit on quantity change
  const quantityInputs = document.querySelectorAll('[data-quantity-input]');
  quantityInputs.forEach(input => {
    input.addEventListener('change', function() {
      const form = this.closest('form');
      if (form) {
        form.submit();
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "class": "cart-section",
  "settings": []
}
{% endschema %}
