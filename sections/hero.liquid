{%- style -%}
  #Hero-{{ section.id }} {
    {%- if section.settings.height == 'full' -%}
      height: 80vh;
    {%- elsif section.settings.height == 'large' -%}
      height: 70vh;
    {%- elsif section.settings.height == 'medium' -%}
      height: 50vh;
    {%- else -%}
      height: 40vh;
    {%- endif -%}
    position: relative;
    overflow: hidden;
  }
  #Hero-{{ section.id }} .hero__media img {
    object-position: top;
    transform: translateY(-9rem);
    height: calc(100% + 10rem);
    width: 100%;
    object-fit: cover;
  }
  #Hero-{{ section.id }} .hero__content {
    position: absolute;
    bottom: 0rem;
    left: 0;
    z-index: 2;
  }
  #Hero-{{ section.id }} .hero__content-bottom {
    padding: 2rem;
    max-width: 500px;
  }
  #Hero-{{ section.id }} .hero__title {
    margin-bottom: 1rem;
    font-family: 'Averta', sans-serif;
    font-weight: 900;
    font-size: 5rem;
    white-space: nowrap;
  }
  #Hero-{{ section.id }} .hero__links {
    display: flex;
    gap: 2rem;
  }
  #Hero-{{ section.id }} .hero__link {
    font-size: 3rem;
  }

  @media (max-width: 768px) {
    #Hero-{{ section.id }} {
      {%- if section.settings.height == 'full' -%}
        height: 60vh;
      {%- elsif section.settings.height == 'large' -%}
        height: 50vh;
      {%- elsif section.settings.height == 'medium' -%}
        height: 40vh;
      {%- else -%}
        height: 35vh;
      {%- endif -%}
    }
    #Hero-{{ section.id }} .hero__media img {
      transform: translateY(-4rem);
      height: calc(100% + 5rem);
    }
    #Hero-{{ section.id }} .hero__content {
      left: 0;
      right: auto;
      text-align: left;
    }
    #Hero-{{ section.id }} .hero__content-bottom {
      padding: 1.5rem;
      max-width: 100%;
      text-align: left;
    }
    #Hero-{{ section.id }} .hero__title {
      font-size: 2.5rem;
      white-space: normal;
      line-height: 1.2;
      margin-bottom: 0.75rem;
      text-align: left;
    }
    #Hero-{{ section.id }} .hero__links {
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: flex-start;
    }
    #Hero-{{ section.id }} .hero__link {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    #Hero-{{ section.id }} .hero__title {
      font-size: 2.25rem;
    }
    #Hero-{{ section.id }} .hero__link {
      font-size: 1.35rem;
    }
    #Hero-{{ section.id }} .hero__content-bottom {
      padding: 1rem;
    }
  }
{%- endstyle -%}

<section id="Hero-{{ section.id }}" class="hero">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.image | image_url: width: 768 }} 768w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.title }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__content container">
    <div class="hero__content-bottom">
      {%- if section.settings.title != blank -%}
        <h1 class="hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}

      {%- if section.settings.link_1_text != blank or section.settings.link_2_text != blank -%}
        <div class="hero__links">
          {%- if section.settings.link_1_text != blank -%}
            <a 
              href="{{ section.settings.link_1_url }}" 
              class="hero__link{% if section.settings.link_1_underline %} hero__link--underline{% endif %}"
            >
              {{ section.settings.link_1_text }}
            </a>
          {%- endif -%}
          {%- if section.settings.link_2_text != blank -%}
            <a 
              href="{{ section.settings.link_2_url }}" 
              class="hero__link{% if section.settings.link_2_underline %} hero__link--underline{% endif %}"
            >
              {{ section.settings.link_2_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (optional)"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small (50vh)" },
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (90vh)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "LEATHER JACKETS"
    },
    {
      "type": "header",
      "content": "Link 1"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link text",
      "default": "MEN"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "link_1_underline",
      "label": "Show underline",
      "default": true
    },
    {
      "type": "header",
      "content": "Link 2"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link text",
      "default": "WOMEN"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "link_2_underline",
      "label": "Show underline",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "settings": {
        "title": "LEATHER JACKETS",
        "link_1_text": "MEN",
        "link_2_text": "WOMEN"
      }
    }
  ]
}
{% endschema %}

