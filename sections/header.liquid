<header class="site-header" data-header>
  <div class="site-header__inner">
    <!-- Logo -->
    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="site-header__logo-link">
        {%- if settings.logo != blank -%}
          <img 
            src="{{ settings.logo | image_url: width: settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width }}"
            loading="eager"
          >
        {%- else -%}
          <span class="site-header__logo-text">
            <span>FINEYST</span> JACKETS
          </span>
        {%- endif -%}
      </a>
    </div>

    <!-- Main Navigation -->
    <nav class="site-header__nav" aria-label="Main navigation">
      <ul class="site-header__nav-list">
        <li class="site-header__nav-item site-header__nav-item--has-mega-menu" data-mega-menu="mens">
          <button type="button" class="site-header__nav-link" data-mega-menu-trigger="mens">
            MEN'S JACKETS
          </button>
          <!-- Men's Mega Menu -->
          <div class="mega-menu mega-menu--mens" data-mega-menu-panel="mens">
            <div class="mega-menu__inner">
              <button class="mega-menu__close" aria-label="Close menu" data-mega-menu-close>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
              <div class="mega-menu__content">
                <div class="mega-menu__grid">
                  <div class="mega-menu__column">
                    <h3 class="mega-menu__column-title">LEATHER JACKETS</h3>
                    <ul class="mega-menu__list">
                      <li><a href="/collections/mens-leather-jackets" class="mega-menu__link">Leather Jackets</a></li>
                      <li><a href="/collections/leather-bomber-jacket-mens" class="mega-menu__link">Leather Bomber Jackets</a></li>
                      <li><a href="/collections/biker-jacket-men" class="mega-menu__link">Biker & Moto Jackets</a></li>
                      <li><a href="/collections/mens-aviator-jackets" class="mega-menu__link">Aviator & Flight Jackets</a></li>
                      <li><a href="/collections/mens-hooded-leather-jackets" class="mega-menu__link">Hooded Leather Jackets</a></li>
                      <li><a href="/collections/mens-suede-jackets" class="mega-menu__link">Suede Jackets</a></li>
                      <li><a href="/collections/mens-leather-vests" class="mega-menu__link">Leather Vests</a></li>
                    </ul>
                  </div>
                  <div class="mega-menu__column">
                    <h3 class="mega-menu__column-title">COATS</h3>
                    <ul class="mega-menu__list">
                      <li><a href="/collections/mens-duster-jackets" class="mega-menu__link">Leather Dusters</a></li>
                      <li><a href="/collections/mens-long-leather-coats" class="mega-menu__link">Long Leather Coats</a></li>
                      <li><a href="/collections/mens-shearling-coats" class="mega-menu__link">Shearling Coats</a></li>
                      <li><a href="/collections/mens-winter-coats" class="mega-menu__link">Winter Coats</a></li>
                      <li><a href="/collections/mens-puffer-jackets" class="mega-menu__link">Puffer Jackets</a></li>
                      <li><a href="/collections/mens-fur-jackets" class="mega-menu__link">Fur & Shearling Jackets</a></li>
                    </ul>
                  </div>
                  <div class="mega-menu__column">
                    <h3 class="mega-menu__column-title">STYLES</h3>
                    <ul class="mega-menu__list">
                      <li><a href="/collections/mens-varsity-jackets" class="mega-menu__link">Varsity Jackets</a></li>
                      <li><a href="/collections/mens-letterman-jackets" class="mega-menu__link">Letterman Jackets</a></li>
                      <li><a href="/collections/mens-denim-jackets" class="mega-menu__link">Denim Jackets</a></li>
                      <li><a href="/collections/mens-leather-blazers" class="mega-menu__link">Leather Blazers</a></li>
                      <li><a href="/collections/mens-lightweight-jackets" class="mega-menu__link">Lightweight Jackets</a></li>
                      <li><a href="/collections/mens-soft-shell-jackets" class="mega-menu__link">Soft Shell Jackets</a></li>
                    </ul>
                  </div>
                  <div class="mega-menu__column">
                    <h3 class="mega-menu__column-title">SPECIAL COLLECTIONS</h3>
                    <ul class="mega-menu__list">
                      <li><a href="/collections/plus-size-leather-jackets" class="mega-menu__link">Plus Size Leather Jackets</a></li>
                      <li><a href="/collections/mens-puffer-vests" class="mega-menu__link">Puffer Vests</a></li>
                      <li><a href="/collections/mens-brown-vintage-leather-jackets" class="mega-menu__link">Vintage Style</a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>
        <li class="site-header__nav-item site-header__nav-item--has-mega-menu" data-mega-menu="womens">
          <button type="button" class="site-header__nav-link" data-mega-menu-trigger="womens">
            WOMEN'S JACKETS
          </button>
          <!-- Women's Mega Menu -->
          <div class="mega-menu mega-menu--womens" data-mega-menu-panel="womens">
            <div class="mega-menu__inner">
              <button class="mega-menu__close" aria-label="Close menu" data-mega-menu-close>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
              <div class="mega-menu__content">
                <div class="mega-menu__grid">
                  <div class="mega-menu__column">
                    <h3 class="mega-menu__column-title">LEATHER JACKETS</h3>
                    <ul class="mega-menu__list">
                      <li><a href="/collections/womens-leather-jackets" class="mega-menu__link">Leather Jackets</a></li>
                      <li><a href="/collections/womens-fashion-leather-jackets" class="mega-menu__link">Fashion Leather Jackets</a></li>
                      <li><a href="/collections/womens-leather-bomber-jackets" class="mega-menu__link">Leather Bomber Jackets</a></li>
                      <li><a href="/collections/womens-leather-biker-jackets" class="mega-menu__link">Leather Biker Jackets</a></li>
                      <li><a href="/collections/womens-suede-leather-jackets" class="mega-menu__link">Suede Leather Jackets</a></li>
                      <li><a href="/collections/womens-leather-blazers" class="mega-menu__link">Leather Blazers</a></li>
                      <li><a href="/collections/womens-leather-vests" class="mega-menu__link">Leather Vests</a></li>
                    </ul>
                  </div>
                  <div class="mega-menu__column">
                    <h3 class="mega-menu__column-title">COATS</h3>
                    <ul class="mega-menu__list">
                      <li><a href="/collections/womens-shearling-coats" class="mega-menu__link">Shearling Coats</a></li>
                      <li><a href="/collections/womens-trench-coats" class="mega-menu__link">Trench Coats</a></li>
                      <li><a href="/collections/womens-winter-coats" class="mega-menu__link">Winter Coats</a></li>
                      <li><a href="/collections/womens-rain-coats" class="mega-menu__link">Rain Coats</a></li>
                      <li><a href="/collections/womens-puffer-jackets" class="mega-menu__link">Puffer Jackets</a></li>
                      <li><a href="/collections/womens-quilted-jackets" class="mega-menu__link">Quilted Jackets</a></li>
                    </ul>
                  </div>
                  <div class="mega-menu__column">
                    <h3 class="mega-menu__column-title">STYLES</h3>
                    <ul class="mega-menu__list">
                      <li><a href="/collections/womens-cropped-jackets" class="mega-menu__link">Cropped Jackets</a></li>
                      <li><a href="/collections/womens-pilot-jackets" class="mega-menu__link">Pilot & Aviator Jackets</a></li>
                      <li><a href="/collections/womens-varsity-jackets" class="mega-menu__link">Varsity Jackets</a></li>
                      <li><a href="/collections/womens-letterman-jackets" class="mega-menu__link">Letterman Jackets</a></li>
                      <li><a href="/collections/womens-denim-jackets" class="mega-menu__link">Denim Jackets</a></li>
                      <li><a href="/collections/womens-anorak-jackets" class="mega-menu__link">Anorak & Ski Jackets</a></li>
                    </ul>
                  </div>
                  <div class="mega-menu__column">
                    <h3 class="mega-menu__column-title">SPECIAL COLLECTIONS</h3>
                    <ul class="mega-menu__list">
                      <li><a href="/collections/womens-puffer-vests" class="mega-menu__link">Puffer Vests</a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>
        <li class="site-header__nav-item">
          <button type="button" class="site-header__nav-link" data-mega-menu-trigger="coats">
            COATS
          </button>
        </li>
        <li class="site-header__nav-item">
          <a href="/pages/contact" class="site-header__nav-link">
            CONTACT US
          </a>
        </li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="site-header__actions">
      <!-- Account -->
      <a href="{{ routes.account_url }}" class="site-header__action" aria-label="Account">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>

      <!-- Search -->
      <button type="button" class="site-header__action" aria-label="Search" data-search-toggle>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </button>

      <!-- Wishlist -->
      <a href="/pages/wishlist" class="site-header__action" aria-label="Wishlist" data-wishlist-link>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="site-header__wishlist-count" data-wishlist-count>0</span>
      </a>

      <!-- Cart -->
      <button type="button" class="site-header__action" aria-label="Cart" data-cart-toggle>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>

      <!-- Mobile Menu Toggle -->
      <button type="button" class="site-header__menu-toggle" aria-label="Menu" data-menu-toggle>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" data-mobile-menu>
  <button type="button" class="mobile-menu__close" aria-label="Close menu" data-menu-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <nav>
    <ul class="mobile-menu__nav-list">
      <li>
        <div  class="mobile-menu__nav-link">
          MEN'S JACKETS
        </div>
      </li>
      <li>
        <div class="mobile-menu__nav-link">
          WOMEN'S JACKETS
        </div>
      </li>
      <li>
        <div class="mobile-menu__nav-link">
          COATS
        </div>
      </li>
      <li>
        <div class="mobile-menu__nav-link">
          CONTACT US
        </div>
      </li>
    </ul>

    {%- if section.settings.sub_menu != blank -%}
      <div class="mobile-menu__sub-nav">
        <p class="mobile-menu__sub-title">Shop by Category</p>
        <ul class="mobile-menu__sub-list">
          {%- for link in section.settings.sub_menu.links -%}
            <li>
              <a href="{{ link.url }}" class="mobile-menu__sub-link">
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_sub_nav",
      "label": "Show category sub-navigation",
      "default": true
    },
    {
      "type": "link_list",
      "id": "sub_menu",
      "label": "Category menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

