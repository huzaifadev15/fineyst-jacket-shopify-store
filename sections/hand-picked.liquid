{%- style -%}
  .hand-picked-section {
    width: 100%;
    display: flex;
    justify-content: center;
    background: white;
    padding: 2rem 0 1rem;
  }

  @media (min-width: 640px) {
    .hand-picked-section {
      padding-bottom: 1rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section {
      padding: 3rem 0 1.5rem;
    }
  }

  .hand-picked-section__container {
    width: 100%;
    max-width: 2000px;
    overflow: hidden;
    position: relative;
    margin: 0 auto;
    padding: 0;
  }

  @media (min-width: 768px) {
    .hand-picked-section__container {
      padding: 0;
    }
  }

  .hand-picked-section__title {
    font-size: 3.25rem !important;
    font-family: 'Averta', sans-serif;
    font-weight: 900;
    text-align: center;
    margin-bottom: 1rem;
    padding: 0 1rem;
    color: #2b2b2b;
    line-height: 1.2;
  }

  @media (max-width: 767px) {
    .hand-picked-section__title {
      font-size: 2.5rem !important;
    }
  }

  @media (min-width: 640px) {
    .hand-picked-section__title {
      font-size: 3rem;
      margin-bottom: 1.5rem;
      padding: 0;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__title {
      font-size: 3.5rem;
    }
  }

  .hand-picked-section__category-nav {
    display: flex;
    justify-content: center;
    margin-top: -0.5rem;
    margin-bottom: 1rem;
    gap: 0.5rem;
    padding: 0 1rem;
  }

  @media (max-width: 767px) {
    .hand-picked-section__category-nav {
      margin-bottom: 0.5rem;
    }
  }

  @media (min-width: 640px) {
    .hand-picked-section__category-nav {
      gap: 0.75rem;
      padding: 0;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__category-nav {
      margin-bottom: 1.5rem;
      gap: 1rem;
    }
  }

  .hand-picked-section__category-btn {
    padding: 0 0.75rem;
    font-size: 1.75rem;
    font-family: 'Averta', sans-serif;
    font-weight: 500;
    transition: color 0.3s ease;
    color: #374151;
    background: none;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .hand-picked-section__category-btn {
      font-size: 2rem !important;
      padding: 0 0.5rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__category-btn {
      font-size: 2.5rem !important;
    }
  }

  .hand-picked-section__category-btn:hover {
    color: #2b2b2b;
  }

  .hand-picked-section__category-text {
    display: inline-block;
    border-bottom: 2px solid transparent;
    padding-bottom: 0.125rem;
    transition: all 0.3s ease;
    font-weight: 700;
  }

  .hand-picked-section__category-btn[aria-pressed="true"] .hand-picked-section__category-text {
    border-bottom-color: #2b2b2b;
    color: #2b2b2b;
  }

  .hand-picked-section__content {
    position: relative;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .hand-picked-section__content {
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__content {
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .hand-picked-section__content {
      padding: 0 3rem;
    }
  }

  @media (min-width: 1280px) {
    .hand-picked-section__content {
      padding: 0 4rem;
    }
  }

  .hand-picked-section__carousel-wrapper {
    overflow: hidden;
    position: relative;
    min-height: auto;
  }

  .hand-picked-section__carousel-wrapper--mobile {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    height: 400px;
    overflow: hidden;
    padding: 0 3.5rem;
    margin-top: -1rem;
  }

  @media (min-width: 640px) {
    .hand-picked-section__carousel-wrapper--mobile {
      height: 450px;
      padding: 0 4rem;
      margin-top: -0.5rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__carousel-wrapper--mobile {
      display: none;
    }
  }

  .hand-picked-section__carousel-wrapper--desktop {
    display: none;
    padding: 1rem 0 0.5rem;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  @media (min-width: 640px) {
    .hand-picked-section__carousel-wrapper--desktop {
      padding: 1.5rem 0 0.75rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__carousel-wrapper--desktop {
      display: block;
      padding: 2rem 0 1rem;
    }
  }

  .hand-picked-section__carousel-track {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.5rem;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    width: max-content;
    will-change: transform;
    position: relative;
  }

  @media (min-width: 640px) {
    .hand-picked-section__carousel-track {
      gap: 0.75rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__carousel-track {
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .hand-picked-section__carousel-track {
      gap: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .hand-picked-section__carousel-track {
      gap: 2rem;
    }
  }

  /* Hide inactive tracks - both men and women */
  .hand-picked-section__carousel-track {
    display: none !important;
  }

  .hand-picked-section__carousel-track.is-active {
    display: flex !important;
  }

  .hand-picked-section__product {
    flex-shrink: 0 !important;
    cursor: pointer;
    width: 220px !important;
    min-width: 220px !important;
    max-width: 220px !important;
    position: relative;
    display: flex !important;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    .hand-picked-section__product {
      width: 240px !important;
      min-width: 240px !important;
      max-width: 240px !important;
    }
  }

  @media (min-width: 1280px) {
    .hand-picked-section__product {
      width: 260px !important;
      min-width: 260px !important;
      max-width: 260px !important;
    }
  }

  .hand-picked-section__product-card {
    position: relative;
    overflow: hidden;
    background: #f3f4f6;
    width: 100% !important;
    height: 330px !important;
    min-height: 330px !important;
    max-height: 330px !important;
  }

  @media (min-width: 1024px) {
    .hand-picked-section__product-card {
      height: 360px !important;
      min-height: 360px !important;
      max-height: 360px !important;
    }
  }

  @media (min-width: 1280px) {
    .hand-picked-section__product-card {
      height: 390px !important;
      min-height: 390px !important;
      max-height: 390px !important;
    }
  }

  .hand-picked-section__product-card img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  .hand-picked-section__product:hover .hand-picked-section__product-card img {
    transform: scale(1.05);
  }

  .hand-picked-section__product-info {
    text-align: center !important;
    margin-top: 0.5rem !important;
    margin-bottom: 0.5rem !important;
    padding: 0 0.25rem !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow: visible !important;
  }

  @media (min-width: 640px) {
    .hand-picked-section__product-info {
      margin-top: 0.75rem !important;
      margin-bottom: 0.75rem !important;
      padding: 0 0.5rem !important;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__product-info {
      margin-top: 1rem !important;
      margin-bottom: 1rem !important;
      padding: 0 0.5rem !important;
    }
  }

  .hand-picked-section__product-title {
    font-weight: 700;
    font-size: 0.75rem;
    color: black;
    text-transform: uppercase;
    line-height: 1.25;
    margin-bottom: 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s ease;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .hand-picked-section__product-title {
      font-size: 0.875rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__product-title {
      font-size: 1rem;
    }
  }

  .hand-picked-section__product:hover .hand-picked-section__product-title {
    color: #2b2b2b;
  }

  .hand-picked-section__product-price {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    flex-wrap: wrap;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .hand-picked-section__product-price {
      gap: 0.5rem;
      font-size: 0.875rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__product-price {
      font-size: 1rem;
    }
  }

  .hand-picked-section__product-price-current {
    color: black;
    font-weight: 700;
  }

  .hand-picked-section__product-price-original {
    color: #6b7280;
    text-decoration: line-through;
    font-size: 0.875rem;
  }

  .hand-picked-section__nav-btn {
    position: absolute;
    top: calc(2rem + 165px);
    transform: translateY(-50%);
    background: black;
    color: white;
    padding: 0.75rem;
    width: 3rem;
    height: 3rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    z-index: 10;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .hand-picked-section__nav-btn {
      width: 3.5rem;
      height: 3.5rem;
      padding: 1rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__nav-btn {
      width: 4rem;
      height: 4rem;
      padding: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .hand-picked-section__nav-btn {
      top: calc(2rem + 180px);
      width: 4.5rem;
      height: 4.5rem;
      padding: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .hand-picked-section__nav-btn {
      top: calc(3rem + 195px);
    }
  }

  /* Hide buttons on very large screens if needed */
  @media (min-width: 1440px) {
    .hand-picked-section__nav-btn {
      display: flex;
    }
  }

  .hand-picked-section__nav-btn:hover {
    background: #1f2937;
  }

  .hand-picked-section__nav-btn--prev {
    left: 0.5rem;
  }

  @media (min-width: 640px) {
    .hand-picked-section__nav-btn--prev {
      left: 1rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__nav-btn--prev {
      left: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hand-picked-section__nav-btn--prev {
      left: 2rem;
    }
  }

  @media (min-width: 1280px) {
    .hand-picked-section__nav-btn--prev {
      left: 3rem;
    }
  }

  .hand-picked-section__nav-btn--next {
    right: 0.5rem;
  }

  @media (min-width: 640px) {
    .hand-picked-section__nav-btn--next {
      right: 1rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__nav-btn--next {
      right: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hand-picked-section__nav-btn--next {
      right: 2rem;
    }
  }

  @media (min-width: 1280px) {
    .hand-picked-section__nav-btn--next {
      right: 3rem;
    }
  }

  /* Mobile carousel button positioning */
  @media (max-width: 767px) {
    .hand-picked-section__nav-btn {
      top: 50%;
      transform: translateY(-50%);
    }
  }

  .hand-picked-section__nav-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (min-width: 640px) {
    .hand-picked-section__nav-icon {
      width: 2rem;
      height: 2rem;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__nav-icon {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hand-picked-section__nav-icon {
      width: 3rem;
      height: 3rem;
    }
  }

  .hand-picked-section__empty-state {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.9);
    z-index: 50;
    width: 100%;
    height: 100%;
  }

  .hand-picked-section__empty-text {
    color: #6b7280;
    font-size: 0.875rem;
    padding: 0 1rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .hand-picked-section__empty-text {
      font-size: 1rem;
      padding: 0;
    }
  }

  @media (min-width: 768px) {
    .hand-picked-section__empty-text {
      font-size: 1.125rem;
    }
  }

  /* Mobile specific styles */
  .hand-picked-section__product-mobile {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60%;
    max-width: 220px;
    min-width: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateX(130%) scale(0.7);
    transition: all 0.3s ease;
    padding: 0 0.5rem;
  }

  @media (min-width: 640px) {
    .hand-picked-section__product-mobile {
      width: 55%;
      max-width: 240px;
      padding: 0;
    }
  }

  .hand-picked-section__product-mobile.is-center {
    opacity: 1;
    transform: translateX(0) scale(1);
    z-index: 3;
    margin-top: 20px;
  }

  .hand-picked-section__product-mobile.is-prev {
    opacity: 1;
    transform: translateX(-100%) scale(0.85);
    z-index: 2;
    margin-top: 10px;
  }

  .hand-picked-section__product-mobile.is-next {
    opacity: 1;
    transform: translateX(100%) scale(0.85);
    z-index: 2;
    margin-top: 10px;
  }

  .hand-picked-section__product-mobile.is-hidden-left {
    transform: translateX(-130%) scale(0.7);
    opacity: 0;
    z-index: 1;
  }

  .hand-picked-section__product-mobile.is-hidden-right {
    transform: translateX(130%) scale(0.7);
    opacity: 0;
    z-index: 1;
  }

  /* Mobile product info styles */
  .hand-picked-section__product-mobile h3 {
    font-size: 0.75rem !important;
    line-height: 1.3;
  }

  @media (min-width: 640px) {
    .hand-picked-section__product-mobile h3 {
      font-size: 0.875rem !important;
    }
  }

  .hand-picked-section__product-mobile .product-price-mobile {
    font-size: 0.75rem !important;
  }

  @media (min-width: 640px) {
    .hand-picked-section__product-mobile .product-price-mobile {
      font-size: 0.875rem !important;
    }
  }
{%- endstyle -%}

<section class="hand-picked-section" data-section-id="{{ section.id }}">
  <div class="hand-picked-section__container">
    <h2 class="hand-picked-section__title">
      {{ section.settings.title | default: "HAND-PICKED FOR YOU" }}
    </h2>
    
    <div class="hand-picked-section__category-nav">
      <button 
        class="hand-picked-section__category-btn" 
        data-handpicked-category="men"
        aria-pressed="true"
      >
        <span class="hand-picked-section__category-text">MEN</span>
      </button>
      <button 
        class="hand-picked-section__category-btn" 
        data-handpicked-category="women"
        aria-pressed="false"
      >
        <span class="hand-picked-section__category-text">WOMEN</span>
      </button>
    </div>

    <div class="hand-picked-section__content">
      <div class="hand-picked-section__carousel-wrapper">
        {%- assign men_collection = collections[section.settings.men_collection] -%}
        {%- assign women_collection = collections[section.settings.women_collection] -%}
        {%- assign products_limit = section.settings.products_to_show | default: 10 -%}

        {%- if men_collection.products.size == 0 and women_collection.products.size == 0 -%}
          <div class="hand-picked-section__empty-state">
            <p class="hand-picked-section__empty-text">No products available for this category.</p>
          </div>
        {%- else -%}
          <!-- Mobile Carousel -->
          <div class="hand-picked-section__carousel-wrapper--mobile" data-handpicked-mobile>
            {%- for product in men_collection.products limit: products_limit -%}
              <div 
                class="hand-picked-section__product-mobile{% if forloop.index == 1 %} is-center{% else %} is-hidden-right{% endif %}" 
                data-product-index="{{ forloop.index0 }}"
                data-gender="men"
              >
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                  <a href="{{ product.url }}" style="position: relative; cursor: pointer; overflow: hidden; width: 100%; aspect-ratio: 252.7 / 383.3;">
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 280 }}"
                        alt="{{ product.title | escape }}"
                        width="280"
                        height="420"
                        style="width: 100%; height: 100%; object-fit: cover;"
                        loading="lazy"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full' }}
                    {%- endif -%}
                  </a>
                  <div style="text-align: center; margin-top: 0.75rem; width: 100%; padding: 0 0.25rem;">
                    <h3 style="font-weight: 600; font-size: 0.75rem; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                      {%- assign title = product.title -%}
                      {%- if title.size > 38 -%}
                        {{ title | truncate: 38 }}...
                      {%- else -%}
                        {{ title }}
                      {%- endif -%}
                    </h3>
                    <div style="display: flex; justify-content: center; align-items: center; gap: 0.25rem; font-size: 0.875rem; margin-top: 0.25rem;">
                      {%- if product.compare_at_price > product.price -%}
                        <div style="color: black; font-weight: 700;">
                          {{ product.price | money }}
                        </div>
                        <div style="color: #6b7280; text-decoration: line-through; font-size: 0.875rem;">
                          {{ product.compare_at_price | money }}
                        </div>
                      {%- else -%}
                        <div style="color: black; font-weight: 700;">
                          {{ product.price | money }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
            {%- for product in women_collection.products limit: products_limit -%}
              <div 
                class="hand-picked-section__product-mobile is-hidden-right" 
                data-product-index="{{ forloop.index0 }}"
                data-gender="women"
              >
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                  <a href="{{ product.url }}" style="position: relative; cursor: pointer; overflow: hidden; width: 100%; aspect-ratio: 252.7 / 383.3;">
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 280 }}"
                        alt="{{ product.title | escape }}"
                        width="280"
                        height="420"
                        style="width: 100%; height: 100%; object-fit: cover;"
                        loading="lazy"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full' }}
                    {%- endif -%}
                  </a>
                  <div style="text-align: center; margin-top: 0.75rem; width: 100%; padding: 0 0.25rem;">
                    <h3 style="font-weight: 600; font-size: 0.75rem; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                      {%- assign title = product.title -%}
                      {%- if title.size > 38 -%}
                        {{ title | truncate: 38 }}...
                      {%- else -%}
                        {{ title }}
                      {%- endif -%}
                    </h3>
                    <div style="display: flex; justify-content: center; align-items: center; gap: 0.25rem; font-size: 0.875rem; margin-top: 0.25rem;">
                      {%- if product.compare_at_price > product.price -%}
                        <div style="color: black; font-weight: 700;">
                          {{ product.price | money }}
                        </div>
                        <div style="color: #6b7280; text-decoration: line-through; font-size: 0.875rem;">
                          {{ product.compare_at_price | money }}
                        </div>
                      {%- else -%}
                        <div style="color: black; font-weight: 700;">
                          {{ product.price | money }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <!-- Desktop Carousel -->
          <div class="hand-picked-section__carousel-wrapper--desktop">
            <div class="hand-picked-section__carousel-track" data-handpicked-track data-gender="men">
              {%- for product in men_collection.products limit: products_limit -%}
                <div class="hand-picked-section__product" data-product-index="{{ forloop.index0 }}">
                  <a href="{{ product.url }}">
                    <div class="hand-picked-section__product-card">
                      {%- if product.featured_image -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 280 }}"
                          alt="{{ product.title | escape }}"
                          width="280"
                          height="420"
                          loading="lazy"
                        >
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'w-full h-full' }}
                      {%- endif -%}
                    </div>
                    <div class="hand-picked-section__product-info">
                      <h3 class="hand-picked-section__product-title">
                        {%- assign title = product.title -%}
                        {%- if title.size > 38 -%}
                          {{ title | truncate: 38 }}...
                        {%- else -%}
                          {{ title }}
                        {%- endif -%}
                      </h3>
                      <div class="hand-picked-section__product-price">
                        {%- if product.compare_at_price > product.price -%}
                          <div class="hand-picked-section__product-price-current">
                            {{ product.price | money }}
                          </div>
                          <div class="hand-picked-section__product-price-original">
                            {{ product.compare_at_price | money }}
                          </div>
                        {%- else -%}
                          <div class="hand-picked-section__product-price-current">
                            {{ product.price | money }}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </a>
                </div>
              {%- endfor -%}
            </div>

            <div class="hand-picked-section__carousel-track" data-handpicked-track data-gender="women">
              {%- for product in women_collection.products limit: products_limit -%}
                <div class="hand-picked-section__product" data-product-index="{{ forloop.index0 }}">
                  <a href="{{ product.url }}">
                    <div class="hand-picked-section__product-card">
                      {%- if product.featured_image -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 280 }}"
                          alt="{{ product.title | escape }}"
                          width="280"
                          height="420"
                          loading="lazy"
                        >
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'w-full h-full' }}
                      {%- endif -%}
                    </div>
                    <div class="hand-picked-section__product-info">
                      <h3 class="hand-picked-section__product-title">
                        {%- assign title = product.title -%}
                        {%- if title.size > 38 -%}
                          {{ title | truncate: 38 }}...
                        {%- else -%}
                          {{ title }}
                        {%- endif -%}
                      </h3>
                      <div class="hand-picked-section__product-price">
                        {%- if product.compare_at_price > product.price -%}
                          <div class="hand-picked-section__product-price-current">
                            {{ product.price | money }}
                          </div>
                          <div class="hand-picked-section__product-price-original">
                            {{ product.compare_at_price | money }}
                          </div>
                        {%- else -%}
                          <div class="hand-picked-section__product-price-current">
                            {{ product.price | money }}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </a>
                </div>
              {%- endfor -%}
            </div>
          </div>

          <button 
            class="hand-picked-section__nav-btn hand-picked-section__nav-btn--prev" 
            data-handpicked-prev
            aria-label="Previous"
          >
            <svg class="hand-picked-section__nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button 
            class="hand-picked-section__nav-btn hand-picked-section__nav-btn--next" 
            data-handpicked-next
            aria-label="Next"
          >
            <svg class="hand-picked-section__nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initHandPickedSection() {
      var section = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!section) return;

      var categoryButtons = section.querySelectorAll('[data-handpicked-category]');
      var tracks = section.querySelectorAll('[data-handpicked-track]');
      var prevBtn = section.querySelector('[data-handpicked-prev]');
      var nextBtn = section.querySelector('[data-handpicked-next]');
      var mobileWrapper = section.querySelector('[data-handpicked-mobile]');
      
      var activeCategory = 'men';
      var scrollPosition = 0;
      var isTransitioning = false;
      var mobileCurrentIndex = 0; // Track current center product index for mobile

      function updateScrollPosition() {
        tracks.forEach(function(track) {
          if (!track.classList.contains('is-active')) return;
          
          // Apply scroll position
          track.style.transform = 'translateX(' + scrollPosition + 'px)';
        });
      }

      // Mobile carousel navigation
      function updateMobileCarousel() {
        if (!mobileWrapper || !isMobileView()) return;
        
        // Hide all products first, then show only active category
        var allMobileProducts = mobileWrapper.querySelectorAll('.hand-picked-section__product-mobile');
        allMobileProducts.forEach(function(product) {
          var productGender = product.getAttribute('data-gender');
          if (productGender !== activeCategory) {
            // Hide products from inactive category
            product.classList.remove('is-center', 'is-prev', 'is-next', 'is-hidden-left', 'is-hidden-right');
            product.style.display = 'none';
            return;
          } else {
            product.style.display = 'flex';
          }
        });
        
        var mobileProducts = mobileWrapper.querySelectorAll('.hand-picked-section__product-mobile[data-gender="' + activeCategory + '"]');
        if (mobileProducts.length === 0) return;
        
        // Ensure index is within bounds
        mobileCurrentIndex = Math.max(0, Math.min(mobileCurrentIndex, mobileProducts.length - 1));
        
        mobileProducts.forEach(function(product, index) {
          // Remove all state classes
          product.classList.remove('is-center', 'is-prev', 'is-next', 'is-hidden-left', 'is-hidden-right');
          
          if (index === mobileCurrentIndex) {
            product.classList.add('is-center');
          } else if (index === mobileCurrentIndex - 1) {
            product.classList.add('is-prev');
          } else if (index === mobileCurrentIndex + 1) {
            product.classList.add('is-next');
          } else if (index < mobileCurrentIndex - 1) {
            product.classList.add('is-hidden-left');
          } else {
            product.classList.add('is-hidden-right');
          }
        });
      }

      function isMobileView() {
        return mobileWrapper && window.getComputedStyle(mobileWrapper).display !== 'none';
      }

      function getScrollAmount() {
        var activeTrack = section.querySelector('[data-handpicked-track].is-active');
        if (!activeTrack) return 300;
        
        var products = activeTrack.querySelectorAll('.hand-picked-section__product');
        if (products.length === 0) return 300;
        
        // Calculate scroll amount based on product width + gap
        // Scroll by approximately 2-3 products at a time for smooth experience
        var firstProduct = products[0];
        if (firstProduct) {
          var productWidth = firstProduct.offsetWidth;
          var computedStyle = window.getComputedStyle(activeTrack);
          var gap = parseFloat(computedStyle.gap) || 8;
          // Scroll by 2.5 products worth for smooth scrolling
          return (productWidth + gap) * 2.5;
        }
        return 300;
      }

      function getMaxScroll() {
        var activeTrack = section.querySelector('[data-handpicked-track].is-active');
        if (!activeTrack) return 0;
        
        var wrapper = activeTrack.closest('.hand-picked-section__carousel-wrapper--desktop');
        if (!wrapper) return 0;
        
        var trackWidth = activeTrack.scrollWidth;
        var wrapperWidth = wrapper.clientWidth;
        var maxScroll = -(trackWidth - wrapperWidth);
        
        return maxScroll;
      }

      // Category switching
      categoryButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var category = this.getAttribute('data-handpicked-category');
          if (category === activeCategory || isTransitioning) return;
          
          activeCategory = category;
          scrollPosition = 0; // Reset scroll position
          mobileCurrentIndex = 0; // Reset mobile carousel index
          isTransitioning = true;

          // Update button states
          categoryButtons.forEach(function(b) {
            var isActive = b.getAttribute('data-handpicked-category') === category;
            b.setAttribute('aria-pressed', isActive);
          });

          // Show/hide desktop tracks
          tracks.forEach(function(track) {
            if (track.getAttribute('data-gender') === category) {
              track.classList.add('is-active');
            } else {
              track.classList.remove('is-active');
            }
          });

          // Update scroll position after category switch
          setTimeout(function() {
            updateScrollPosition();
            // Update mobile carousel only if on mobile view
            if (isMobileView()) {
              updateMobileCarousel();
            }
            isTransitioning = false;
          }, 50);
        });
      });

      // Navigation - Handle both mobile and desktop
      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (isTransitioning) return;
          
          isTransitioning = true;
          
          // Check if we're on mobile view
          if (isMobileView()) {
            // Mobile navigation
            var mobileProducts = mobileWrapper.querySelectorAll('.hand-picked-section__product-mobile[data-gender="' + activeCategory + '"]');
            if (mobileProducts.length > 0) {
              mobileCurrentIndex = Math.max(0, mobileCurrentIndex - 1);
              updateMobileCarousel();
            }
            setTimeout(function() {
              isTransitioning = false;
            }, 300);
          } else {
            // Desktop navigation
            var scrollAmount = getScrollAmount();
            var maxScroll = getMaxScroll();
            
            scrollPosition = Math.min(0, scrollPosition + scrollAmount);
            updateScrollPosition();
            
            setTimeout(function() {
              isTransitioning = false;
            }, 500);
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (isTransitioning) return;
          
          isTransitioning = true;
          
          // Check if we're on mobile view
          if (isMobileView()) {
            // Mobile navigation
            var mobileProducts = mobileWrapper.querySelectorAll('.hand-picked-section__product-mobile[data-gender="' + activeCategory + '"]');
            if (mobileProducts.length > 0) {
              mobileCurrentIndex = Math.min(mobileProducts.length - 1, mobileCurrentIndex + 1);
              updateMobileCarousel();
            }
            setTimeout(function() {
              isTransitioning = false;
            }, 300);
          } else {
            // Desktop navigation
            var scrollAmount = getScrollAmount();
            var maxScroll = getMaxScroll();
            
            scrollPosition = Math.max(maxScroll, scrollPosition - scrollAmount);
            updateScrollPosition();
            
            setTimeout(function() {
              isTransitioning = false;
            }, 500);
          }
        });
      }

      // Initialize on load
      function initializeCarousel() {
        // Always initialize desktop tracks - ensure they're visible
        tracks.forEach(function(track) {
          var trackGender = track.getAttribute('data-gender');
          if (trackGender === activeCategory) {
            track.classList.add('is-active');
          } else {
            track.classList.remove('is-active');
          }
        });
        
        // Update desktop scroll position
        scrollPosition = 0;
        updateScrollPosition();
        
        // Initialize mobile carousel only if on mobile view
        if (isMobileView()) {
          mobileCurrentIndex = 0;
          updateMobileCarousel();
        }
      }
      
      // Initialize after DOM is ready
      setTimeout(initializeCarousel, 100);

      // Update on window resize
      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
          // Ensure desktop tracks are properly shown
          tracks.forEach(function(track) {
            if (track.getAttribute('data-gender') === activeCategory) {
              track.classList.add('is-active');
            } else {
              track.classList.remove('is-active');
            }
          });
          
          // Ensure scroll position is still valid after resize
          var maxScroll = getMaxScroll();
          scrollPosition = Math.max(maxScroll, Math.min(0, scrollPosition));
          updateScrollPosition();
          
          // Reset mobile carousel if switching to mobile view
          if (isMobileView()) {
            mobileCurrentIndex = 0;
            updateMobileCarousel();
          }
        }, 250);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHandPickedSection);
    } else {
      initHandPickedSection();
    }
  })();
</script>

{% schema %}
{
  "name": "Hand-Picked Products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "HAND-PICKED FOR YOU"
    },
    {
      "type": "collection",
      "id": "men_collection",
      "label": "Men's Collection"
    },
    {
      "type": "collection",
      "id": "women_collection",
      "label": "Women's Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 10,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Hand-Picked Products"
    }
  ]
}
{% endschema %}
