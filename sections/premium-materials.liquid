

 <section class="premium-materials-section section-carousel-item" data-carousel-index="0" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="premium-materials-section__grid">
      
      <div class="premium-materials-section__content">
        <div class="premium-materials-section__nav">
          <button type="button" class="premium-materials-section__nav-btn premium-materials-section__nav-btn--prev section-carousel-prev" aria-label="Previous">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        </div>

        <h2 class="premium-materials-section__title slider-content-title">{{ section.settings.title }}</h2>
        <p class="premium-materials-section__description slider-content-description">{{ section.settings.description }}</p>
        
        <div class="premium-materials-section__features">
          <h3 class="premium-materials-section__features-heading">{{ section.settings.features_heading }}</h3>
          <ul class="premium-materials-section__features-list slider-content-features">
            {%- for block in section.blocks -%}
              <li class="premium-materials-section__feature" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
        
        <div class="premium-materials-section__pagination section-carousel-pagination">
          <span class="premium-materials-section__pagination-dot section-carousel-dot active" data-index="0"></span>
          <span class="premium-materials-section__pagination-dot section-carousel-dot" data-index="1"></span>
          <span class="premium-materials-section__pagination-dot section-carousel-dot" data-index="2"></span>
        </div>
      </div>
      
      <div class="premium-materials-section__visual">
        <div class="premium-materials-section__image">
          {%- if section.settings.image != blank -%}
            <img class="slider-content-image" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title }}" loading="lazy">
          {%- else -%}
            <img class="slider-content-image" src="{{ 'option_1.webp' | asset_url }}" alt="{{ section.settings.title }}" loading="lazy">
          {%- endif -%}
        </div>
        <div class="premium-materials-section__nav-right">
          <button type="button" class="premium-materials-section__nav-btn premium-materials-section__nav-btn--next section-carousel-next" aria-label="Next">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium Materials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "PREMIUM MATERIALS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We source only the finest materials from around the world to create jackets that stand the test of time."
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features Heading",
      "default": "Key Features"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Premium full-grain leather"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Materials",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "Premium full-grain leather"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "YKK zippers for durability"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Soft quilted lining"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Hand-stitched details"
          }
        }
      ]
    }
  ]
}
{% endschema %} 
