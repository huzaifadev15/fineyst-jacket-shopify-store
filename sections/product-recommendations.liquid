{%- style -%}
  .product-recommendations {
    width: 100%;
    padding-left: 1rem;
    padding-right: 0;
    margin-bottom: 2rem;
    margin-top: 4rem;
    height: auto;
  }

  @media (min-width: 640px) {
    .product-recommendations {
      padding-left: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .product-recommendations {
      padding-left: 2rem;
      margin-bottom: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .product-recommendations {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .product-recommendations__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-right: 1rem;
  }

  @media (min-width: 640px) {
    .product-recommendations__header {
      padding-right: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .product-recommendations__header {
      padding-right: 0;
    }
  }

  .product-recommendations__title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
    color: #000;
  }

  .product-recommendations__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .product-recommendations__nav {
      display: none;
    }
  }

  .product-recommendations__nav-btn {
    width: 4rem;
    height: 4rem;
    background: #000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .product-recommendations__nav-btn:hover {
    background: #374151;
  }

  .product-recommendations__nav-btn svg {
    width: 2rem;
    height: 2rem;
  }

  .product-recommendations__mobile-wrapper {
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .product-recommendations__mobile-wrapper {
      display: none;
    }
  }

  .product-recommendations__mobile-track {
    display: flex;
    gap: 1rem;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    touch-action: pan-x;
  }

  .product-recommendations__mobile-item {
    flex-shrink: 0;
    width: calc(58vw - 1rem);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-recommendations__desktop-wrapper {
    display: none;
    position: relative;
  }

  @media (min-width: 768px) {
    .product-recommendations__desktop-wrapper {
      display: block;
      position: relative;
    }
  }

  .product-recommendations__desktop-track {
    overflow: hidden;
  }

  .product-recommendations__desktop-grid {
    display: flex;
    gap: 0.75rem;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @media (min-width: 640px) {
    .product-recommendations__desktop-grid {
      gap: 1rem;
    }
  }

  @media (min-width: 768px) {
    .product-recommendations__desktop-grid {
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .product-recommendations__desktop-grid {
      gap: 1.25rem;
    }
  }

  @media (min-width: 1280px) {
    .product-recommendations__desktop-grid {
      gap: 1.5rem;
    }
  }

  .product-recommendations__desktop-item {
    flex-shrink: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    width: calc(25% - 0.75rem);
    user-select: none;
  }

  .product-recommendations__desktop-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #000;
    color: #fff;
    padding: 1rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    z-index: 10;
    display: none;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .product-recommendations__desktop-nav {
      display: flex !important;
    }
  }

  .product-recommendations__desktop-nav:hover {
    background: #374151;
  }

  .product-recommendations__desktop-nav--prev {
    left: -1rem;
  }

  @media (min-width: 1024px) {
    .product-recommendations__desktop-nav--prev {
      left: -1.5rem;
    }
  }

  .product-recommendations__desktop-nav--next {
    right: -1rem;
  }

  @media (min-width: 1024px) {
    .product-recommendations__desktop-nav--next {
      right: -1.5rem;
    }
  }

  .product-recommendations__desktop-nav svg {
    height: 2rem;
    width: 2rem;
  }

  .product-recommendations__image-container {
    position: relative;
    flex: 1;
    aspect-ratio: 3/5;
    overflow: visible;
    background: #f3f4f6;
  }

  @media (min-width: 768px) {
    .product-recommendations__image-container {
      overflow: hidden;
      width: 100%;
    }
  }

  .product-recommendations__image {
    object-fit: cover;
    object-position: top;
    width: 100%;
    height: 100%;
    transition: all 0.3s ease;
  }

  @media (min-width: 768px) {
    .product-recommendations__desktop-item:hover .product-recommendations__image {
      transform: scale(1.1);
    }
  }

  .product-recommendations__wishlist-btn {
    position: absolute;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    z-index: 10;
    right: 4.5rem;
    bottom: -1rem;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .product-recommendations__wishlist-btn {
      top: 0.5rem;
      right: 0.5rem;
      bottom: auto;
      width: 3rem;
      height: 3rem;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(6px);
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
    }

    .product-recommendations__wishlist-btn:hover {
      transform: scale(1.2);
      background: rgba(248, 248, 248, 0.95);
    }
  }

  .product-recommendations__cart-btn {
    position: absolute;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    z-index: 10;
    right: 0.25rem;
    bottom: -1rem;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .product-recommendations__cart-btn {
      display: none;
    }
  }

  .product-recommendations__badge {
    position: absolute;
    top: 0.5rem;
    left: 0;
    z-index: 10;
    transform: scale(0.9);
  }

  .product-recommendations__badge-inner {
    position: relative;
  }

  .product-recommendations__badge-text {
    background: #000;
    color: #fff;
    padding: 0.125rem 0.375rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
  }

  .product-recommendations__badge-text span {
    font-weight: 600;
    letter-spacing: 0.05em;
    font-size: 0.5625rem;
  }

  .product-recommendations__badge-arrow {
    position: absolute;
    top: 100%;
    left: 0;
    width: 0;
    height: 0;
    border-top: 5px solid #7f1d1d;
    border-right: 5px solid transparent;
  }

  .product-recommendations__content {
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .product-recommendations__content {
      margin-top: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .product-recommendations__content {
      margin-top: 1rem;
    }
  }

  .product-recommendations__title-text {
    font-size: 1.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .product-recommendations__title-text {
      text-transform: uppercase;
      line-height: 1;
      font-size: 1.5rem;
    }
  }

  .product-recommendations__price {
    margin-top: 0.25rem;
  }

  .product-recommendations__price-regular {
    font-size: 2rem;
    font-weight: 700;
    color: #000;
  }

  .product-recommendations__price-compare {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .product-recommendations__price-sale {
    font-size: 2rem;
    font-weight: 700;
    color: #000;
  }

  .product-recommendations__price-original {
    font-size: 2rem;
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
  }

  .product-recommendations__colors {
    margin-top: 0.5rem;
  }

  .product-recommendations__color-selector {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    background: #f9fafb;
    border: 1px solid #000;
  }

  @media (min-width: 768px) {
    .product-recommendations__color-selector {
      padding: 0.5rem 0.75rem;
    }
  }

  .product-recommendations__color-display {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .product-recommendations__color-swatch {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.3);
  }

  .product-recommendations__color-name {
    font-size: 1.5rem;
    color: #374151;
  }

  .product-recommendations__color-more {
    font-size: 0.75rem;
    color: #6b7280;
    text-decoration: underline;
    transition: color 0.3s ease;
    background: none;
    border: none;
    cursor: pointer;
  }

  .product-recommendations__color-more:hover {
    color: #374151;
  }

  .product-recommendations__size-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    z-index: 20;
    opacity: 0;
    transform: translateY(1.25rem);
    transition: all 0.15s ease;
  }

  .product-recommendations__desktop-item:hover .product-recommendations__size-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .product-recommendations__size-content {
    padding: 1.5rem;
  }

  .product-recommendations__size-label {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .product-recommendations__size-label-gray {
    color: #6b7280;
  }

  .product-recommendations__size-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .product-recommendations__size-btn {
    padding: 0.75rem 1.25rem;
    font-size: 1.5rem;
    border: none;
    background: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .product-recommendations__size-btn:hover {
    border-color: #000;
  }
{%- endstyle -%}

{%- liquid
  assign products_to_show = section.settings.products_count | default: 4
  assign has_recommendations = false
  assign products_list = blank
  
  if recommendations.products_count > 0
    assign has_recommendations = true
    assign products_list = recommendations.products
  elsif collection and collection.products_count > 1
    assign has_recommendations = true
    assign products_list = collection.products
  elsif product.collections.size > 0
    assign first_collection = product.collections.first
    if first_collection.products_count > 1
      assign has_recommendations = true
      assign products_list = first_collection.products
    endif
  endif
-%}

{%- if has_recommendations -%}
<section class="product-recommendations" data-product-recommendations>
  <div class="product-recommendations__header">
    {%- if section.settings.title != blank -%}
      <span class="product-recommendations__title">{{ section.settings.title }}</span>
    {%- endif -%}
    <div class="product-recommendations__nav">
      <button type="button" class="product-recommendations__nav-btn" data-mobile-prev style="display: none;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button type="button" class="product-recommendations__nav-btn" data-mobile-next style="display: none;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Carousel -->
  <div class="product-recommendations__mobile-wrapper" data-mobile-wrapper>
    <div class="product-recommendations__mobile-track" data-mobile-track>
      {%- assign product_count = 0 -%}
      {%- for product_item in products_list -%}
        {%- unless product_item.id == product.id -%}
          {%- if product_count < products_to_show -%}
            <div class="product-recommendations__mobile-item" data-product-id="{{ product_item.id }}" data-product-handle="{{ product_item.handle }}">
              <div class="product-recommendations__image-container">
                <img 
                  src="{{ product_item.featured_image | image_url: width: 1200 }}" 
                  alt="{{ product_item.title }}"
                  class="product-recommendations__image"
                  width="1200"
                  height="1800"
                  loading="lazy"
                >
                
                <button class="product-recommendations__wishlist-btn" data-wishlist-btn data-product-id="{{ product_item.id }}">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="black" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                
                <button class="product-recommendations__cart-btn" data-cart-btn data-product-id="{{ product_item.id }}">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6.5 9h11L19 21H5L6.5 9z" />
                    <path d="M9 9c0-2.76 1.38-5 3-5s3 2.24 3 5" />
                  </svg>
                </button>
                
                {%- if product_item.tags contains 'featured' -%}
                  <div class="product-recommendations__badge">
                    <div class="product-recommendations__badge-inner">
                      <div class="product-recommendations__badge-text">
                        <span>BEST SELLING</span>
                      </div>
                      <div class="product-recommendations__badge-arrow"></div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
              
              <div class="product-recommendations__content">
                <p class="product-recommendations__title-text">{{ product_item.title }}</p>
                <div class="product-recommendations__price">
                  {%- if product_item.compare_at_price > product_item.price -%}
                    <div class="product-recommendations__price-compare">
                      <span class="product-recommendations__price-sale">{{ product_item.price | money }}</span>
                      <span class="product-recommendations__price-original">{{ product_item.compare_at_price | money }}</span>
                    </div>
                  {%- else -%}
                    <span class="product-recommendations__price-regular">{{ product_item.price | money }}</span>
                  {%- endif -%}
                </div>
                
                <div class="product-recommendations__colors">
                  <div class="product-recommendations__color-selector">
                    <div class="product-recommendations__color-display">
                      <div class="product-recommendations__color-swatch" style="background-color: #000000;"></div>
                      <span class="product-recommendations__color-name">Black</span>
                    </div>
                    {%- if product_item.options contains 'Color' -%}
                      <button class="product-recommendations__color-more" data-color-trigger data-product-id="{{ product_item.id }}">
                        +{{ product_item.options_with_values[0].values.size | minus: 1 }} more
                      </button>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
            {%- assign product_count = product_count | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- Desktop Carousel -->
  <div class="product-recommendations__desktop-wrapper" data-desktop-wrapper>
    <div class="product-recommendations__desktop-track" data-desktop-track>
      <div class="product-recommendations__desktop-grid" data-desktop-grid>
        {%- assign product_count = 0 -%}
        {%- for product_item in products_list -%}
          {%- unless product_item.id == product.id -%}
            {%- if product_count < products_to_show -%}
              <div class="product-recommendations__desktop-item" data-product-id="{{ product_item.id }}" data-product-handle="{{ product_item.handle }}" data-hover-target="love-{{ product_item.id }}-{{ product_count }}">
                <div class="product-recommendations__image-container">
                  <img 
                    src="{{ product_item.featured_image | image_url: width: 1200 }}" 
                    alt="{{ product_item.title }}"
                    class="product-recommendations__image"
                    width="1200"
                    height="1800"
                    loading="lazy"
                    data-primary-image="{{ product_item.featured_image | image_url: width: 1200 }}"
                    {%- if product_item.images[1] -%}
                      data-hover-image="{{ product_item.images[1] | image_url: width: 1200 }}"
                    {%- endif -%}
                  >
                  
                  <button class="product-recommendations__wishlist-btn" data-wishlist-btn data-product-id="{{ product_item.id }}">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </button>
                  
                  {%- if product_item.tags contains 'featured' -%}
                    <div class="product-recommendations__badge">
                      <div class="product-recommendations__badge-inner">
                        <div class="product-recommendations__badge-text">
                          <span>BEST SELLING</span>
                        </div>
                        <div class="product-recommendations__badge-arrow"></div>
                      </div>
                    </div>
                  {%- endif -%}
                  
                  <div class="product-recommendations__size-overlay" data-size-overlay>
                    <div class="product-recommendations__size-content">
                      <div class="product-recommendations__size-label">
                        Quick Shop <span class="product-recommendations__size-label-gray">(Select your Size)</span>
                      </div>
                      <div class="product-recommendations__size-buttons">
                        <button class="product-recommendations__size-btn" data-size="S">S</button>
                        <button class="product-recommendations__size-btn" data-size="M">M</button>
                        <button class="product-recommendations__size-btn" data-size="L">L</button>
                        <button class="product-recommendations__size-btn" data-size="XL">XL</button>
                        <button class="product-recommendations__size-btn" data-size="2XL">2XL</button>
                        <button class="product-recommendations__size-btn" data-size="3XL">3XL</button>
                        <button class="product-recommendations__size-btn" data-size="4XL">4XL</button>
                      </div>
                    </div>
                  </div>
                </div>
                
                <div class="product-recommendations__content">
                  <p class="product-recommendations__title-text">{{ product_item.title | upcase }}</p>
                  <div class="product-recommendations__price">
                    {%- if product_item.compare_at_price > product_item.price -%}
                      <div class="product-recommendations__price-compare">
                        <span class="product-recommendations__price-sale">{{ product_item.price | money }}</span>
                        <span class="product-recommendations__price-original">{{ product_item.compare_at_price | money }}</span>
                      </div>
                    {%- else -%}
                      <span class="product-recommendations__price-regular">{{ product_item.price | money }}</span>
                    {%- endif -%}
                  </div>
                  
                  <div class="product-recommendations__colors">
                    <div class="product-recommendations__color-selector">
                      <div class="product-recommendations__color-display">
                        <div class="product-recommendations__color-swatch" style="background-color: #000000;"></div>
                        <span class="product-recommendations__color-name">Black</span>
                      </div>
                      {%- if product_item.options contains 'Color' -%}
                        <button class="product-recommendations__color-more" data-color-trigger data-product-id="{{ product_item.id }}">
                          +{{ product_item.options_with_values[0].values.size | minus: 1 }} more
                        </button>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
              {%- assign product_count = product_count | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
    
    <button class="product-recommendations__desktop-nav product-recommendations__desktop-nav--prev" data-desktop-prev>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    
    <button class="product-recommendations__desktop-nav product-recommendations__desktop-nav--next" data-desktop-next>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</section>

<script>
(function() {
  let currentIndex = 0;

  function initCarousel() {
    const section = document.querySelector('[data-product-recommendations]');
    if (!section) return;

    const mobileTrack = section.querySelector('[data-mobile-track]');
    const mobilePrev = section.querySelector('[data-mobile-prev]');
    const mobileNext = section.querySelector('[data-mobile-next]');
    
    const desktopGrid = section.querySelector('[data-desktop-grid]');
    const desktopPrev = section.querySelector('[data-desktop-prev]');
    const desktopNext = section.querySelector('[data-desktop-next]');

    function isMobile() {
      return window.innerWidth < 768;
    }

    function updateCarousel() {
      if (isMobile() && mobileTrack) {
        const item = mobileTrack.querySelector('.product-recommendations__mobile-item');
        if (item) {
          const itemWidth = item.offsetWidth;
          const gap = 16;
          const scrollAmount = itemWidth + gap;
          mobileTrack.style.transform = `translateX(-${currentIndex * scrollAmount}px)`;
        }
      } else if (desktopGrid) {
        const item = desktopGrid.querySelector('.product-recommendations__desktop-item');
        if (item) {
          const itemWidth = item.offsetWidth;
          const gap = parseFloat(getComputedStyle(desktopGrid).gap) || 20;
          const scrollAmount = itemWidth + gap;
          desktopGrid.style.transform = `translateX(-${currentIndex * scrollAmount}px)`;
        }
      }
      updateButtons();
    }

    function updateButtons() {
      if (isMobile()) {
        const mobileItems = section.querySelectorAll('.product-recommendations__mobile-item');
        const maxIndex = Math.max(0, mobileItems.length - 1);
        if (mobilePrev) mobilePrev.style.display = currentIndex > 0 ? 'flex' : 'none';
        if (mobileNext) mobileNext.style.display = currentIndex < maxIndex ? 'flex' : 'none';
      } else {
        const desktopItems = section.querySelectorAll('.product-recommendations__desktop-item');
        const maxIndex = Math.max(0, desktopItems.length - 1);
        if (desktopPrev) desktopPrev.style.display = currentIndex > 0 ? 'flex' : 'none';
        if (desktopNext) desktopNext.style.display = currentIndex < maxIndex ? 'flex' : 'none';
      }
    }

    function handleNext() {
      const items = section.querySelectorAll(isMobile() ? '.product-recommendations__mobile-item' : '.product-recommendations__desktop-item');
      const maxIndex = Math.max(0, items.length - 1);
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateCarousel();
      }
    }

    function handlePrev() {
      if (currentIndex > 0) {
        currentIndex--;
        updateCarousel();
      }
    }

    // Mobile button events
    if (mobilePrev) {
      mobilePrev.addEventListener('click', function(e) {
        e.preventDefault();
        handlePrev();
      });
    }
    if (mobileNext) {
      mobileNext.addEventListener('click', function(e) {
        e.preventDefault();
        handleNext();
      });
    }

    // Desktop button events
    if (desktopPrev) {
      desktopPrev.addEventListener('click', function(e) {
        e.preventDefault();
        handlePrev();
      });
    }
    if (desktopNext) {
      desktopNext.addEventListener('click', function(e) {
        e.preventDefault();
        handleNext();
      });
    }

    // Touch events for mobile swipe
    if (mobileTrack) {
      let touchStartX = null;
      let touchEndX = null;

      mobileTrack.addEventListener('touchstart', function(e) {
        touchStartX = e.touches[0].clientX;
      });

      mobileTrack.addEventListener('touchmove', function(e) {
        touchEndX = e.touches[0].clientX;
      });

      mobileTrack.addEventListener('touchend', function() {
        if (!touchStartX || !touchEndX) return;
        const distance = touchStartX - touchEndX;
        const isLeftSwipe = distance > 50;
        const isRightSwipe = distance < -50;

        if (isLeftSwipe) {
          handleNext();
        } else if (isRightSwipe) {
          handlePrev();
        }

        touchStartX = null;
        touchEndX = null;
      });
    }

    // Hover effects for desktop
    section.querySelectorAll('.product-recommendations__desktop-item').forEach(function(item) {
      const img = item.querySelector('.product-recommendations__image');
      const hoverImage = img?.dataset.hoverImage;
      const primaryImage = img?.dataset.primaryImage;

      if (hoverImage && primaryImage) {
        item.addEventListener('mouseenter', function() {
          img.src = hoverImage;
        });

        item.addEventListener('mouseleave', function() {
          img.src = primaryImage;
        });
      }
    });

    // Wishlist functionality
    let wishlistItems = [];
    
    // Get wishlist from localStorage in the format expected by wishlist page
    function getWishlist() {
      try {
        const wishlist = localStorage.getItem('wishlist-storage');
        if (!wishlist) return [];
        const parsed = JSON.parse(wishlist);
        return parsed.state?.items || [];
      } catch (e) {
        return [];
      }
    }
    
    // Save wishlist in the format expected by wishlist page
    function saveWishlist(items) {
      try {
        const wishlistData = {
          state: { items: items },
          version: 0
        };
        localStorage.setItem('wishlist-storage', JSON.stringify(wishlistData));
      } catch (e) {
        console.error('Error saving wishlist:', e);
      }
    }
    
    wishlistItems = getWishlist();
    
    section.querySelectorAll('[data-wishlist-btn]').forEach(function(btn) {
      const productId = btn.dataset.productId;
      updateWishlistButton(btn, wishlistItems.some(item => String(item.id) === String(productId)));

      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        
        // Get product data from the DOM
        const productCard = this.closest('[data-product-handle]');
        const productHandle = productCard.dataset.productHandle;
        const productTitle = productCard.querySelector('.product-recommendations__title-text').textContent;
        const productImage = productCard.querySelector('.product-recommendations__image').src;
        const productPrice = productCard.querySelector('.product-recommendations__price-regular, .product-recommendations__price-sale');
        
        const productData = {
          id: productId,
          handle: productHandle,
          name: productTitle,
          image: productImage,
          images: [productImage],
          price: productPrice ? parseInt(productPrice.textContent.replace(/[^0-9]/g, '')) * 100 : 0,
          url: `/products/${productHandle}`,
          variants: [{ id: productId, price: productPrice ? parseInt(productPrice.textContent.replace(/[^0-9]/g, '')) * 100 : 0 }],
          colorDetails: [{ name: 'Black', value: '#000000' }]
        };
        
        toggleWishlist(productId, btn, productData);
      });
    });

    // Initialize wishlist count
    updateWishlistCount();

    function toggleWishlist(productId, btn, productData) {
      const existingIndex = wishlistItems.findIndex(item => String(item.id) === String(productId));
      
      if (existingIndex > -1) {
        wishlistItems.splice(existingIndex, 1);
      } else {
        wishlistItems.push(productData);
      }
      
      saveWishlist(wishlistItems);
      updateWishlistButton(btn, wishlistItems.some(item => String(item.id) === String(productId)));
      updateWishlistCount();
    }

    function updateWishlistCount() {
      const wishlistCountElement = document.querySelector('.wishlist-count, [data-wishlist-count]');
      if (wishlistCountElement) {
        wishlistCountElement.textContent = wishlistItems.length;
        wishlistCountElement.style.display = wishlistItems.length > 0 ? 'block' : 'none';
      }
    }

    function updateWishlistButton(btn, isInWishlist) {
      const svg = btn.querySelector('svg path');
      if (svg) {
        svg.setAttribute('fill', isInWishlist ? 'black' : 'none');
      }
    }

    // Size button functionality for quick add to cart
    section.querySelectorAll('.product-recommendations__size-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const size = this.dataset.size;
        const productCard = this.closest('[data-product-handle]');
        const productHandle = productCard.dataset.productHandle;
        
        // Get the first available variant ID for this product
        fetch(`/products/${productHandle}.js`)
          .then(response => response.json())
          .then(product => {
            // Find variant with matching size or use first variant
            let variantId = product.variants[0].id;
            if (product.variants.length > 1) {
              const sizeVariant = product.variants.find(v => 
                v.option1 === size || v.option2 === size || v.option3 === size
              );
              if (sizeVariant) {
                variantId = sizeVariant.id;
              }
            }
            
            // Add to cart
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                id: variantId,
                quantity: 1,
                properties: { Size: size }
              })
            });
          })
          .then(response => response.json())
          .then(data => {
            // Complete cart update system
            updateCartSystem();
          })
          .catch(error => {
            console.error('Error:', error);
          });
      });
    });

    // Complete cart update system
    function updateCartSystem() {
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          // Update cart icon count
          const cartCountElements = document.querySelectorAll('[data-cart-count], .cart-count, .header__cart-count');
          cartCountElements.forEach(el => {
            el.textContent = cart.item_count;
            el.style.display = cart.item_count > 0 ? 'block' : 'none';
          });
          
          // Update cart sidebar items
          const itemsContainer = document.querySelector('[data-cart-sidebar-items]');
          if (itemsContainer && cart.items) {
            itemsContainer.innerHTML = cart.items.map(item => `
              <div style="display: flex; gap: 1rem; padding: 1rem; border-bottom: 1px solid #eee;">
                <img src="${item.image}" alt="${item.title}" width="60" height="80" style="object-fit: cover; border-radius: 4px;">
                <div style="flex: 1;">
                  <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem; font-weight: 600;">${item.title}</h4>
                  <p style="margin: 0; color: #666; font-size: 0.9rem;">Size: ${item.properties?.Size || 'N/A'}</p>
                  <p style="margin: 0.5rem 0 0 0; font-weight: bold;">Qty: ${item.quantity} × $${(item.price/100).toFixed(2)}</p>
                </div>
              </div>
            `).join('');
          }
          
          // Update cart totals
          const subtotalElement = document.querySelector('[data-cart-sidebar-subtotal]');
          const totalElement = document.querySelector('[data-cart-sidebar-total]');
          if (subtotalElement) subtotalElement.textContent = `$${(cart.total_price/100).toFixed(2)}`;
          if (totalElement) totalElement.textContent = `$${(cart.total_price/100).toFixed(2)}`;
          
          // Open cart sidebar
          const cartSidebar = document.querySelector('[data-cart-sidebar]');
          if (cartSidebar) {
            cartSidebar.classList.add('is-open');
            document.body.style.overflow = 'hidden';
          }
          
          // Trigger cart update event
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
        })
        .catch(error => {
          console.error('Error updating cart:', error);
        });
    }

    // Product clicks
    section.querySelectorAll('[data-product-handle]').forEach(function(item) {
      item.style.cursor = 'pointer';
      item.addEventListener('click', function(e) {
        // Don't navigate if clicking on buttons
        if (e.target.closest('button')) return;
        
        const productHandle = this.dataset.productHandle;
        if (productHandle) {
          window.location.href = '/products/' + productHandle;
        }
      });
    });

    // Initialize
    currentIndex = 0;
    updateCarousel();
    
    // Reset on resize
    window.addEventListener('resize', function() {
      currentIndex = 0;
      updateCarousel();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "You'll Also Love"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ]
}
{% endschema %}