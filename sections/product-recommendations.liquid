{%- style -%}
  .product-recommendations {
    padding: 6rem 2rem;
  }

  .product-recommendations__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4rem;
  }

  .product-recommendations__title {
    font-size: 2.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #000;
    margin: 0;
  }

  .product-recommendations__nav {
    display: flex;
    gap: 1rem;
  }

  .product-recommendations__nav-btn {
    width: 4rem;
    height: 4rem;
    background: #000;
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }

  @media (min-width: 601px) {
    .product-recommendations__nav-btn {
      display: none;
    }
  }

  .product-recommendations__nav-btn:hover:not(:disabled) {
    opacity: 0.8;
  }

  .product-recommendations__nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .product-recommendations__nav-btn svg {
    width: 2rem;
    height: 2rem;
    stroke: currentColor;
  }

  .product-recommendations__wrapper {
    position: relative;
    overflow: hidden;
  }

  .product-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
    transition: transform 0.3s ease;
  }

  @media (max-width: 1200px) {
    .product-recommendations__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .product-recommendations__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .product-recommendations {
      padding: 4rem 1.5rem;
    }

    .product-recommendations__header {
      margin-bottom: 2rem;
      padding: 0 1.5rem;
    }

    .product-recommendations__title {
      font-size: 2rem;
    }

    .product-recommendations__nav-btn {
      width: 3.5rem;
      height: 3.5rem;
    }

    .product-recommendations__nav-btn svg {
      width: 1.6rem;
      height: 1.6rem;
    }

    .product-recommendations__wrapper {
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 0 1.5rem;
    }

    .product-recommendations__wrapper::-webkit-scrollbar {
      display: none;
    }

    .product-recommendations__grid {
      display: flex;
      grid-template-columns: none;
      gap: 1.5rem;
      width: max-content;
    }

    .product-recommendations__grid > * {
      min-width: calc(50vw - 2.25rem);
      max-width: calc(50vw - 2.25rem);
      flex-shrink: 0;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_to_show = section.settings.products_count | default: 4
  assign has_recommendations = false
  assign products_list = blank
  
  if recommendations.products_count > 0
    assign has_recommendations = true
    assign products_list = recommendations.products
  elsif collection and collection.products_count > 1
    assign has_recommendations = true
    assign products_list = collection.products
  elsif product.collections.size > 0
    assign first_collection = product.collections.first
    if first_collection.products_count > 1
      assign has_recommendations = true
      assign products_list = first_collection.products
    endif
  endif
-%}

{%- if has_recommendations -%}
<section class="product-recommendations" data-product-recommendations>
  <div class="container">
    <div class="product-recommendations__header">
      {%- if section.settings.title != blank -%}
        <h2 class="product-recommendations__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      <div class="product-recommendations__nav">
        <button type="button" class="product-recommendations__nav-btn product-recommendations__nav-btn--prev" aria-label="Previous" data-recommendations-prev>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="product-recommendations__nav-btn product-recommendations__nav-btn--next" aria-label="Next" data-recommendations-next>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="product-recommendations__wrapper" data-recommendations-wrapper>
      <div class="product-recommendations__grid" data-recommendations-grid>
        {%- assign product_count = 0 -%}
        {%- for product_item in products_list -%}
          {%- unless product_item.id == product.id -%}
            {%- if product_count < products_to_show -%}
              {% render 'product-card', product: product_item %}
              {%- assign product_count = product_count | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  function initRecommendationsCarousel() {
    const section = document.querySelector('[data-product-recommendations]');
    if (!section) return;

    const wrapper = section.querySelector('[data-recommendations-wrapper]');
    const grid = section.querySelector('[data-recommendations-grid]');
    const prevBtn = section.querySelector('[data-recommendations-prev]');
    const nextBtn = section.querySelector('[data-recommendations-next]');

    if (!wrapper || !grid || !prevBtn || !nextBtn) return;

    function isMobile() {
      return window.innerWidth <= 600;
    }

    function updateButtons() {
      const scrollLeft = wrapper.scrollLeft;
      const scrollWidth = grid.scrollWidth;
      const clientWidth = wrapper.clientWidth;
      const maxScroll = Math.max(0, scrollWidth - clientWidth);
      const hasOverflow = scrollWidth > clientWidth;

      if (!hasOverflow) {
        prevBtn.disabled = true;
        nextBtn.disabled = true;
        return;
      }

      prevBtn.disabled = scrollLeft <= 5;
      nextBtn.disabled = scrollLeft >= maxScroll - 5;
    }

    function scroll(direction) {
      const cards = grid.querySelectorAll('.product-card');
      if (cards.length === 0) return;
      
      let scrollAmount;
      
      if (isMobile()) {
        const firstCard = cards[0];
        if (!firstCard) return;
        const cardWidth = firstCard.offsetWidth || firstCard.getBoundingClientRect().width;
        const gap = 24; // 1.5rem
        scrollAmount = cardWidth + gap;
      } else {
        // Desktop: scroll by one card width
        const firstCard = cards[0];
        if (!firstCard) return;
        const cardWidth = firstCard.offsetWidth || firstCard.getBoundingClientRect().width;
        const gap = 48; // 3rem for desktop
        scrollAmount = cardWidth + gap;
      }

      if (direction === 'next') {
        wrapper.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      } else {
        wrapper.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      }
      
      setTimeout(updateButtons, 400);
    }

    // Remove any existing listeners
    const newPrevBtn = prevBtn.cloneNode(true);
    const newNextBtn = nextBtn.cloneNode(true);
    prevBtn.parentNode.replaceChild(newPrevBtn, prevBtn);
    nextBtn.parentNode.replaceChild(newNextBtn, nextBtn);

    newPrevBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (!newPrevBtn.disabled) {
        scroll('prev');
      }
    }, { passive: false });
    
    newNextBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (!newNextBtn.disabled) {
        scroll('next');
      }
    }, { passive: false });
    
    wrapper.addEventListener('scroll', updateButtons, { passive: true });
    
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(updateButtons, 250);
    });

    // Initial state
    setTimeout(updateButtons, 300);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecommendationsCarousel);
  } else {
    setTimeout(initRecommendationsCarousel, 100);
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "You'll Also Love"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ]
}
{% endschema %}

