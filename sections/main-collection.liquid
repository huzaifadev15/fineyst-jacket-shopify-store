<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Category Sidebar
    const categoryButton = document.querySelector('[data-category-dropdown]');
    const categorySidebar = document.querySelector('[data-category-sidebar]');
    const categoryOverlay = document.querySelector('[data-category-overlay]');
    const categoryClose = document.querySelector('[data-category-close]');
    const categorySearch = document.querySelector('[data-category-search]');
    const categoryList = document.querySelector('[data-category-list]');
    const categoryItems = document.querySelectorAll('[data-category-item]');
    const viewToggleButtons = document.querySelectorAll('[data-view-toggle]');
    
    function openCategorySidebar() {
      if (categorySidebar) categorySidebar.classList.add('is-open');
      if (categoryOverlay) categoryOverlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeCategorySidebar() {
      if (categorySidebar) categorySidebar.classList.remove('is-open');
      if (categoryOverlay) categoryOverlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (categoryButton) {
      categoryButton.addEventListener('click', openCategorySidebar);
    }

    if (categoryClose) {
      categoryClose.addEventListener('click', closeCategorySidebar);
    }

    if (categoryOverlay) {
      categoryOverlay.addEventListener('click', closeCategorySidebar);
    }

    // Search functionality
    if (categorySearch && categoryItems) {
      categorySearch.addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        categoryItems.forEach(function(item) {
          const itemName = item.querySelector('.collection-category-sidebar__item-name').textContent.toLowerCase();
          if (itemName.includes(searchTerm)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }

    // View toggle functionality
    if (viewToggleButtons && categoryList) {
      viewToggleButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          const viewType = this.getAttribute('data-view-toggle');
          viewToggleButtons.forEach(function(btn) {
            btn.classList.remove('is-active');
          });
          this.classList.add('is-active');
          
          if (viewType === 'list') {
            categoryList.classList.add('is-list-view');
          } else {
            categoryList.classList.remove('is-list-view');
          }
        });
      });
    }

    // Sort Dropdown
    const sortButton = document.querySelector('[data-sort-button]');
    const sortMenu = document.querySelector('[data-sort-menu]');
    const sortItems = document.querySelectorAll('[data-sort-value]');
    
    if (sortButton && sortMenu) {
      sortButton.addEventListener('click', function(e) {
        e.stopPropagation();
        const wasOpen = sortMenu.classList.contains('is-open');
        
        if (wasOpen) {
          sortMenu.classList.remove('is-open');
          sortButton.classList.remove('is-active');
          sortMenu.style.display = 'none';
          sortMenu.style.opacity = '0';
          sortMenu.style.visibility = 'hidden';
        } else {
          // Calculate position
          const buttonRect = sortButton.getBoundingClientRect();
          const wrapperRect = sortButton.closest('.collection-toolbar__sort-wrapper').getBoundingClientRect();
          
          sortMenu.style.top = (buttonRect.bottom + 8) + 'px';
          sortMenu.style.left = wrapperRect.left + 'px';
          sortMenu.style.width = wrapperRect.width + 'px';
          
          sortMenu.classList.add('is-open');
          sortButton.classList.add('is-active');
          sortMenu.style.display = 'block';
          sortMenu.style.opacity = '1';
          sortMenu.style.visibility = 'visible';
        }
      });

      sortItems.forEach(function(item) {
        item.addEventListener('click', function(e) {
          e.stopPropagation();
          const sortValue = this.getAttribute('data-sort-value');
          if (sortValue) {
            const url = new URL(window.location.href);
            url.searchParams.set('sort_by', sortValue);
            window.location.href = url.toString();
          }
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (sortMenu && sortMenu.classList.contains('is-open')) {
          if (!sortButton.contains(e.target) && !sortMenu.contains(e.target)) {
            sortMenu.classList.remove('is-open');
            sortButton.classList.remove('is-active');
            sortMenu.style.display = 'none';
            sortMenu.style.opacity = '0';
            sortMenu.style.visibility = 'hidden';
          }
        }
      });

      function closeSortDropdown() {
        if (sortMenu && sortMenu.classList.contains('is-open')) {
          sortMenu.classList.remove('is-open');
          sortButton.classList.remove('is-active');
          sortMenu.style.display = 'none';
          sortMenu.style.opacity = '0';
          sortMenu.style.visibility = 'hidden';
        }
      }

      window.addEventListener('scroll', closeSortDropdown, { passive: true });
      window.addEventListener('touchmove', closeSortDropdown, { passive: true });
    }

    // Filter Sidebar
    const filterToggle = document.querySelector('[data-filter-toggle]');
    const filterSidebar = document.querySelector('[data-filter-sidebar]');
    const filterOverlay = document.querySelector('[data-filter-overlay]');
    const filterClose = document.querySelector('[data-filter-close]');
    const filterInputs = document.querySelectorAll('[data-filter-input]');
    
    function openFilterSidebar() {
      if (filterSidebar) filterSidebar.classList.add('is-open');
      if (filterOverlay) filterOverlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeFilterSidebar() {
      if (filterSidebar) filterSidebar.classList.remove('is-open');
      if (filterOverlay) filterOverlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    function applyFilters() {
      const url = new URL(window.location.href);
      const checkboxes = document.querySelectorAll('[data-filter-input]:checked');
      
      // Clear existing filter params - collect keys first to avoid iteration issues
      const keysToDelete = [];
      url.searchParams.forEach(function(value, key) {
        if (key.startsWith('filter.v')) {
          keysToDelete.push(key);
        }
      });
      keysToDelete.forEach(function(key) {
        url.searchParams.delete(key);
      });

      // Group filters by name to handle multiple values
      const filterGroups = {};
      checkboxes.forEach(function(checkbox) {
        const filterName = checkbox.name;
        const filterValue = checkbox.value;
        if (!filterGroups[filterName]) {
          filterGroups[filterName] = [];
        }
        filterGroups[filterName].push(filterValue);
      });

      // Add selected filters - for Shopify, we append multiple values with the same key
      Object.keys(filterGroups).forEach(function(filterName) {
        const values = filterGroups[filterName];
        values.forEach(function(value) {
          url.searchParams.append(filterName, value);
        });
      });

      // Close filter sidebar
      closeFilterSidebar();

      window.location.href = url.toString();
    }

    if (filterToggle) {
      filterToggle.addEventListener('click', openFilterSidebar);
    }

    if (filterClose) {
      filterClose.addEventListener('click', closeFilterSidebar);
    }

    if (filterOverlay) {
      filterOverlay.addEventListener('click', closeFilterSidebar);
    }

    // Restore filter state from URL parameters on page load
    function restoreFilterState() {
      const urlParams = new URLSearchParams(window.location.search);
      if (filterInputs) {
        filterInputs.forEach(function(checkbox) {
          const filterName = checkbox.name;
          const filterValue = checkbox.value;
          // Check if this filter value exists in URL params
          const paramValues = urlParams.getAll(filterName);
          if (paramValues.includes(filterValue)) {
            checkbox.checked = true;
          }
        });
      }
    }

    // Update active filters display (only inside modal)
    function updateActiveFiltersDisplay() {
      const activeFiltersList = document.querySelector('[data-active-filters-list]');
      const clearAllBtn = document.querySelector('[data-clear-all-filters]');
      if (!activeFiltersList) return;

      const urlParams = new URLSearchParams(window.location.search);
      activeFiltersList.innerHTML = '';

      const filterLabels = {
        'filter.v.option.color': 'Color',
        'filter.v.option.material': 'Material',
        'filter.v.option.style': 'Style',
        'filter.v.option.gender': 'Gender',
        'filter.v.availability': 'Size'
      };

      let hasActiveFilters = false;

      urlParams.forEach(function(value, key) {
        if (key.startsWith('filter.v')) {
          hasActiveFilters = true;
          const filterLabel = filterLabels[key] || key.replace('filter.v.option.', '').replace('filter.v.', '');
          const filterTag = document.createElement('div');
          filterTag.className = 'collection-filter-sidebar__active-filter';
          filterTag.innerHTML = `
            <span class="collection-filter-sidebar__active-filter-name">${filterLabel}: ${value}</span>
            <button type="button" class="collection-filter-sidebar__active-filter-remove" data-remove-filter="${key}" data-remove-value="${encodeURIComponent(value)}" aria-label="Remove filter">&times;</button>
          `;
          activeFiltersList.appendChild(filterTag);
        }
      });

      if (clearAllBtn) {
        clearAllBtn.style.display = hasActiveFilters ? 'block' : 'none';
      }
    }

    // Remove individual filter
    function removeFilter(filterName, filterValue) {
      const url = new URL(window.location.href);
      const values = url.searchParams.getAll(filterName);
      url.searchParams.delete(filterName);
      
      // Re-add all values except the one being removed
      values.forEach(function(value) {
        if (decodeURIComponent(value) !== decodeURIComponent(filterValue)) {
          url.searchParams.append(filterName, value);
        }
      });

      window.location.href = url.toString();
    }

    // Clear all filters
    function clearAllFilters() {
      const url = new URL(window.location.href);
      url.searchParams.forEach(function(value, key) {
        if (key.startsWith('filter.v')) {
          url.searchParams.delete(key);
        }
      });
      window.location.href = url.toString();
    }

    // Client-side product filtering based on URL parameters
    function filterProducts() {
      const collectionGrid = document.querySelector('[data-collection-grid]');
      if (!collectionGrid) return;

      const urlParams = new URLSearchParams(window.location.search);
      const productWrappers = collectionGrid.querySelectorAll('.product-card-wrapper');
      
      // Get active filters from URL
      const activeFilters = {
        color: urlParams.getAll('filter.v.option.color'),
        material: urlParams.getAll('filter.v.option.material'),
        style: urlParams.getAll('filter.v.option.style'),
        gender: urlParams.getAll('filter.v.option.gender'),
        availability: urlParams.getAll('filter.v.availability')
      };

      // Check if any filters are active
      const hasActiveFilters = Object.keys(activeFilters).some(key => activeFilters[key].length > 0);

      let visibleCount = 0;

      productWrappers.forEach(function(wrapper) {
        let shouldShow = true;

        // If no filters are active, show all products
        if (!hasActiveFilters) {
          wrapper.style.display = '';
          visibleCount++;
          return;
        }

        // Helper function to normalize and compare values
        function normalizeValue(value) {
          return value.toLowerCase().trim().replace(/\s+/g, ' ');
        }

        function valuesMatch(productValue, filterValue) {
          const normalizedProduct = normalizeValue(productValue);
          const normalizedFilter = normalizeValue(filterValue);
          return normalizedProduct === normalizedFilter || 
                 normalizedProduct.includes(normalizedFilter) || 
                 normalizedFilter.includes(normalizedProduct);
        }

        // Filter by color
        if (activeFilters.color.length > 0) {
          const productColorAttr = wrapper.getAttribute('data-product-color') || '';
          if (productColorAttr === '') {
            shouldShow = false;
          } else {
            const productColors = productColorAttr.split('|').map(c => c.trim()).filter(c => c);
            const filterColors = activeFilters.color.map(c => decodeURIComponent(c).trim());
            const hasMatchingColor = productColors.some(pc => 
              filterColors.some(fc => valuesMatch(pc, fc))
            );
            if (!hasMatchingColor) {
              shouldShow = false;
            }
          }
        }

        // Filter by material
        if (shouldShow && activeFilters.material.length > 0) {
          const productMaterialAttr = wrapper.getAttribute('data-product-material') || '';
          if (productMaterialAttr === '') {
            shouldShow = false;
          } else {
            const productMaterials = productMaterialAttr.split('|').map(m => m.trim()).filter(m => m);
            const filterMaterials = activeFilters.material.map(m => decodeURIComponent(m).trim());
            const hasMatchingMaterial = productMaterials.some(pm => 
              filterMaterials.some(fm => valuesMatch(pm, fm))
            );
            if (!hasMatchingMaterial) {
              shouldShow = false;
            }
          }
        }

        // Filter by style
        if (shouldShow && activeFilters.style.length > 0) {
          const productStyleAttr = wrapper.getAttribute('data-product-style') || '';
          if (productStyleAttr === '') {
            shouldShow = false;
          } else {
            const productStyles = productStyleAttr.split('|').map(s => s.trim()).filter(s => s);
            const filterStyles = activeFilters.style.map(s => decodeURIComponent(s).trim());
            const hasMatchingStyle = productStyles.some(ps => 
              filterStyles.some(fs => valuesMatch(ps, fs))
            );
            if (!hasMatchingStyle) {
              shouldShow = false;
            }
          }
        }

        // Filter by gender
        if (shouldShow && activeFilters.gender.length > 0) {
          const productGenderAttr = wrapper.getAttribute('data-product-gender') || '';
          if (productGenderAttr === '') {
            shouldShow = false;
          } else {
            const productGenders = productGenderAttr.split('|').map(g => g.trim()).filter(g => g);
            const filterGenders = activeFilters.gender.map(g => decodeURIComponent(g).trim());
            const hasMatchingGender = productGenders.some(pg => 
              filterGenders.some(fg => valuesMatch(pg, fg))
            );
            if (!hasMatchingGender) {
              shouldShow = false;
            }
          }
        }

        // Filter by availability (size)
        if (shouldShow && activeFilters.availability.length > 0) {
          const productSizes = (wrapper.getAttribute('data-product-sizes') || '').split('|').map(s => s.trim()).filter(s => s);
          // For availability filter, we just check if product has any sizes available
          if (productSizes.length === 0) {
            shouldShow = false;
          }
        }

        // Show or hide product
        if (shouldShow) {
          wrapper.style.display = '';
          visibleCount++;
        } else {
          wrapper.style.display = 'none';
        }
      });

      // Show "no products" message if no products visible
      const existingMsg = collectionGrid.querySelector('p[data-no-products-msg]');
      if (visibleCount === 0 && hasActiveFilters) {
        if (!existingMsg) {
          const msg = document.createElement('p');
          msg.setAttribute('data-no-products-msg', 'true');
          msg.textContent = 'No products found matching your filters.';
          msg.style.gridColumn = '1 / -1';
          msg.style.textAlign = 'center';
          msg.style.padding = '4rem 2rem';
          msg.style.fontSize = '1.6rem';
          msg.style.color = '#666';
          collectionGrid.appendChild(msg);
        }
      } else if (existingMsg) {
        existingMsg.remove();
      }
    }

    // Restore filters on page load
    restoreFilterState();
    updateActiveFiltersDisplay();

    // Handle remove filter clicks
    document.addEventListener('click', function(e) {
      if (e.target.closest('[data-remove-filter]')) {
        const button = e.target.closest('[data-remove-filter]');
        const filterName = button.getAttribute('data-remove-filter');
        const filterValue = button.getAttribute('data-remove-value');
        removeFilter(filterName, filterValue);
      }
    });

    // Handle clear all filters
    const clearAllBtn = document.querySelector('[data-clear-all-filters]');
    if (clearAllBtn) {
      clearAllBtn.addEventListener('click', clearAllFilters);
    }

    // Apply button - apply filters when clicked
    const applyBtn = document.querySelector('[data-filter-apply]');
    if (applyBtn) {
      applyBtn.addEventListener('click', function() {
        applyFilters();
      });
    }

    // Reset button - clear all filters from URL
    const resetBtn = document.querySelector('[data-filter-reset]');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        // Clear all checkboxes
        if (filterInputs) {
          filterInputs.forEach(function(checkbox) {
            checkbox.checked = false;
          });
        }
        // Clear all filters from URL and reload
        const url = new URL(window.location.href);
        url.searchParams.forEach(function(value, key) {
          if (key.startsWith('filter.v')) {
            url.searchParams.delete(key);
          }
        });
        window.location.href = url.toString();
      });
    }

    // Update active filters when sidebar opens
    if (filterToggle) {
      const originalOpen = openFilterSidebar;
      openFilterSidebar = function() {
        originalOpen();
        updateActiveFiltersDisplay();
      };
    }

    // Run filtering on page load (filterProducts is defined earlier)
    filterProducts();

    // Re-filter when URL changes (for back/forward navigation)
    window.addEventListener('popstate', function() {
      restoreFilterState();
      updateActiveFiltersDisplay();
      filterProducts();
    });

    // Size Finder Modal
    const sizeModalToggle = document.querySelector('[data-size-modal-toggle]');
    const sizeModal = document.querySelector('[data-size-modal]');
    const sizeModalOverlay = document.querySelector('[data-size-modal-overlay]');
    const sizeModalClose = document.querySelector('[data-size-modal-close]');
    
    function openSizeModal() {
      if (sizeModal) sizeModal.classList.add('is-open');
      if (sizeModalOverlay) sizeModalOverlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeSizeModal() {
      if (sizeModal) sizeModal.classList.remove('is-open');
      if (sizeModalOverlay) sizeModalOverlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (sizeModalToggle) {
      sizeModalToggle.addEventListener('click', openSizeModal);
    }

    if (sizeModalClose) {
      sizeModalClose.addEventListener('click', closeSizeModal);
    }

    if (sizeModalOverlay) {
      sizeModalOverlay.addEventListener('click', closeSizeModal);
    }
  });
</script>

