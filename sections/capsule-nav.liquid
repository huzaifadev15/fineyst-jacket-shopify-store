{%- style -%}
  .capsule-nav {
    position: fixed;
    top: 6rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    width: 90%;
    max-width: 67rem;
    transition: all 0.3s ease;
  }
  
  .capsule-nav__container {
    background: #fff;
    border-radius: 15px;
    padding: 0.4rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  }
  
  .capsule-nav__list {
    display: flex;
    gap: 0.4rem;
    overflow-x: scroll;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    user-select: none;
    scroll-behavior: smooth;
  }
  
  .capsule-nav__list:active {
    cursor: grabbing;
  }
  
  .capsule-nav__list::-webkit-scrollbar {
    display: none;
  }
  
  .capsule-nav__item {
    flex-shrink: 0;
  }
  
  .capsule-nav__link {
    display: block;
    padding: 1rem 2.4rem;
    border-radius: 13px;
    font-family: 'Averta', sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
    color: #000;
    background: transparent;
  }
  
  .capsule-nav__link:hover {
    background: #f5f5f5;
  }
  
  .capsule-nav__link--active {
    background: #2b2b2b !important;
    color: #fff !important;
  }
  
  @media (max-width: 768px) {
    .capsule-nav {
      width: 95%;
      top: 6rem;
    }
    
    .capsule-nav__link {
      padding: 0.8rem 1.6rem;
      font-size: 1.2rem;
    }
  }
{%- endstyle -%}

<nav class="capsule-nav" id="capsule-nav">
  <div class="capsule-nav__container">
    <ul class="capsule-nav__list">
      <li class="capsule-nav__item">
        <a href="/" class="capsule-nav__link{% if template.name == 'index' %} capsule-nav__link--active{% endif %}">
          HOME
        </a>
      </li>
      <li class="capsule-nav__item">
        <a href="/collections/mens-leather-jackets" class="capsule-nav__link{% if collection.handle == 'mens-leather-jackets' %} capsule-nav__link--active{% endif %}">
          LEATHER
        </a>
      </li>
      <li class="capsule-nav__item">
        <a href="/collections/leather-bomber-jacket-mens" class="capsule-nav__link{% if collection.handle == 'leather-bomber-jacket-mens' %} capsule-nav__link--active{% endif %}">
          BOMBER
        </a>
      </li>
      <li class="capsule-nav__item">
        <a href="/collections/biker-jacket-men" class="capsule-nav__link{% if collection.handle == 'biker-jacket-men' %} capsule-nav__link--active{% endif %}">
          BIKER
        </a>
      </li>
      <li class="capsule-nav__item">
        <a href="/collections/mens-varsity-jackets" class="capsule-nav__link{% if collection.handle == 'mens-varsity-jackets' %} capsule-nav__link--active{% endif %}">
          VARSITY
        </a>
      </li>
      <li class="capsule-nav__item">
        <a href="/collections/mens-puffer-jackets" class="capsule-nav__link{% if collection.handle == 'mens-puffer-jackets' %} capsule-nav__link--active{% endif %}">
          PUFFER
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const capsuleNav = document.getElementById('capsule-nav');
  const navList = capsuleNav.querySelector('.capsule-nav__list');
  let lastScrollY = 0;
  let isVisible = true;
  let isDragging = false;
  let startX = 0;
  let scrollLeft = 0;

  // Scroll visibility logic
  function handleScroll() {
    const currentScrollY = window.scrollY;
    const TOP_THRESHOLD = 5;

    const shouldShow = currentScrollY <= TOP_THRESHOLD;
    
    if (shouldShow !== isVisible) {
      isVisible = shouldShow;
      capsuleNav.style.opacity = isVisible ? '1' : '0';
      capsuleNav.style.pointerEvents = isVisible ? 'auto' : 'none';
      capsuleNav.style.transform = isVisible ? 'translateX(-50%)' : 'translateX(-50%) translateY(-100%)';
    }

    lastScrollY = currentScrollY;
  }

  // Drag to scroll functionality
  navList.addEventListener('mousedown', function(e) {
    isDragging = true;
    startX = e.pageX - navList.offsetLeft;
    scrollLeft = navList.scrollLeft;
    navList.style.cursor = 'grabbing';
    e.preventDefault();
  });

  navList.addEventListener('mouseleave', function() {
    isDragging = false;
    navList.style.cursor = 'grab';
  });

  navList.addEventListener('mouseup', function() {
    isDragging = false;
    navList.style.cursor = 'grab';
  });

  navList.addEventListener('mousemove', function(e) {
    if (!isDragging) return;
    e.preventDefault();
    const x = e.pageX - navList.offsetLeft;
    const walk = (x - startX) * 2;
    navList.scrollLeft = scrollLeft - walk;
  });

  // Touch events for mobile
  navList.addEventListener('touchstart', function(e) {
    isDragging = true;
    startX = e.touches[0].pageX - navList.offsetLeft;
    scrollLeft = navList.scrollLeft;
  });

  navList.addEventListener('touchmove', function(e) {
    if (!isDragging) return;
    const x = e.touches[0].pageX - navList.offsetLeft;
    const walk = (x - startX) * 2;
    navList.scrollLeft = scrollLeft - walk;
  });

  navList.addEventListener('touchend', function() {
    isDragging = false;
  });

  // Set initial cursor
  navList.style.cursor = 'grab';

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
});
</script>

{% schema %}
{
  "name": "Capsule Navigation",
  "tag": "section",
  "class": "capsule-nav-section",
  "settings": [],
  "presets": [
    {
      "name": "Capsule Navigation"
    }
  ]
}
{% endschema %}