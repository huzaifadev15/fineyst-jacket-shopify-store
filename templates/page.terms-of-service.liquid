---
layout: theme
---

{%- style -%}
  .terms-page {
    min-height: 100vh;
    background: #fff;
  }
  
  .terms-header {
    position: relative;
    overflow: hidden;
    background: #f6f6f6;
  }
  
  .terms-header__content {
    position: relative;
    z-index: 10;
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 2rem;
    padding-top: 8rem;
    padding-bottom: 10rem;
    text-align: center;
  }
  
  .terms-header__title {
    font-size: clamp(5rem, 6vw, 7rem);
    font-weight: 700;
    color: #000;
    margin-bottom: 3rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .terms-header__description {
    font-size: clamp(2rem, 2.5vw, 2.4rem);
    color: #000;
    margin-bottom: 5rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .terms-header__features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
    max-width: 60rem;
    margin: 0 auto;
  }
  
  .terms-header__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .terms-header__feature-icon {
    width: 6.4rem;
    height: 6.4rem;
    border-radius: 50%;
    background: #eaeaea;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
  
  .terms-header__feature-icon svg {
    width: 3.2rem;
    height: 3.2rem;
    color: #000;
  }
  
  .terms-header__feature-text {
    font-weight: 500;
    color: #000;
    font-family: avertaDefault, sans-serif;
  }
  
  .terms-content {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 2rem;
    padding-top: 6rem;
    padding-bottom: 6rem;
  }
  
  .terms-card {
    background: #fff;
    border-radius: 0.5rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    border: 1px solid #e5e7eb;
    overflow: hidden;
  }
  
  .terms-card__content {
    padding: 6rem 4rem;
  }
  
  .terms-section {
    margin-bottom: 5rem;
  }
  
  .terms-section h2 {
    font-size: 2.8rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 2rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .terms-section p {
    color: #374151;
    margin-bottom: 2rem;
    line-height: 1.7;
    font-size: 1.8rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .terms-section ul {
    list-style: disc;
    padding-left: 3rem;
    color: #374151;
    margin-bottom: 2rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .terms-section li {
    margin-bottom: 1rem;
    font-size: 1.8rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .terms-section strong {
    font-weight: 600;
  }
  
  .contact-section {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 3rem;
  }
  
  .contact-section h2 {
    font-size: 2.8rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 2rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .contact-section p {
    color: #374151;
    margin-bottom: 2rem;
    font-size: 1.8rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  
  .contact-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 2rem;
  }
  
  .contact-card h3 {
    font-size: 2rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 1rem;
    font-family: avertaDefault, sans-serif;
  }
  
  .contact-card p {
    color: #374151;
    font-size: 1.8rem;
    margin-bottom: 0;
    font-family: avertaDefault, sans-serif;
  }
  
  .contact-links {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .contact-links a {
    color: #2b2b2b;
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  
  .contact-links a:hover {
    text-decoration: underline;
  }
  
  .contact-links .arrow {
    margin-right: 0.5rem;
  }
  
  @media (max-width: 768px) {
    .terms-header__features {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
    
    .terms-card__content {
      padding: 3rem 2rem;
    }
    
    .terms-section h2 {
      font-size: 2rem;
    }
    
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .contact-links {
      flex-direction: column;
      gap: 1rem;
      align-items: stretch;
    }
  }
{%- endstyle -%}

