---
layout: theme
---

{%- style -%}
  .size-guide-page {
    min-height: 100vh;
    background: #fff;
  }
  
  .size-guide-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(to right, #2b2b2b, #fff, #2b2b2b);
    padding: 8rem 0 6rem;
  }
  
  .bg-grid-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    background-image: linear-gradient(to right, #e5e7eb 1px, transparent 1px), linear-gradient(to bottom, #e5e7eb 1px, transparent 1px);
    background-size: 40px 40px;
  }
  
  .size-guide-hero__content {
    position: relative;
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
  }
  
  .size-guide-hero__title {
    font-family: avertaDefault, "avertaDefault Fallback", Arial, Helvetica, sans-serif;
    font-size: clamp(3rem, 5vw, 6rem);
    font-weight: 700;
    color: #000;
    margin-bottom: 2rem;
    margin-top: 3rem;
  }
  
  .size-guide-hero__description {
    font-size: clamp(1.6rem, 2vw, 2rem);
    color: #333;
    margin-bottom: 4rem;
  }
  
  .size-guide-hero__features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 80rem;
    margin: 0 auto;
  }
  
  .size-guide-hero__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .size-guide-hero__feature-icon {
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 50%;
    background: #eaeaea;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .size-guide-hero__feature-icon svg {
    width: 2.8rem;
    height: 2.8rem;
    color: #2b2b2b;
  }
  
  .size-guide-hero__feature-text {
    font-weight: 500;
    color: #2b2b2b;
  }
  
  .size-guide-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
    border-bottom: 1px solid #eaeaea;
  }
  
  .size-guide-nav--scrolled {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .size-guide-nav__content {
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 2rem;
  }
  
  .size-guide-nav__list {
    display: flex;
    overflow-x: auto;
    padding: 1rem 0;
    gap: 2rem;
  }
  
  .size-guide-nav__item {
    white-space: nowrap;
    padding: 1rem 2rem;
    border-radius: 2rem;
    font-weight: 500;
    color: #666;
    background: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }
  
  .size-guide-nav__item:hover,
  .size-guide-nav__item--active {
    background: #2b2b2b;
    color: #fff;
  }
  
  .size-guide-progress {
    height: 4px;
    width: 100%;
    background: #eaeaea;
    border-radius: 2px;
    overflow: hidden;
  }
  
  .size-guide-progress__bar {
    height: 100%;
    background: #2b2b2b;
    transition: width 0.3s ease;
    width: 0%;
  }
  
  .size-guide-content {
    max-width: 120rem;
    margin: 0 auto;
    padding: 6rem 2rem;
  }
  
  .size-guide-section {
    margin-bottom: 12rem;
    scroll-margin-top: 8rem;
  }
  
  .size-guide-section__title {
    font-family: avertaDefault, "avertaDefault Fallback", Arial, Helvetica, sans-serif;
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 700;
    color: #2B2B2B;
    margin-bottom: 1.5rem;
  }
  
  .size-guide-section__description {
    font-size: 1.8rem;
    color: #666;
    margin-bottom: 4rem;
    max-width: 60rem;
  }
  
  .size-chart-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  .size-chart-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .size-chart-tab {
    padding: 1rem 2rem;
    border-radius: 2rem;
    font-size: 1.4rem;
    font-weight: 500;
    background: #f6f6f6;
    color: #000;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .size-chart-tab--active {
    background: #2b2b2b;
    color: #fff;
  }
  
  .unit-toggle {
    display: flex;
    background: #f6f6f6;
    border-radius: 2rem;
    padding: 0.4rem;
  }
  
  .unit-toggle__button {
    padding: 0.8rem 1.6rem;
    border-radius: 1.6rem;
    font-size: 1.4rem;
    background: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #000;
  }
  
  .unit-toggle__button--active {
    background: #2b2b2b;
    color: #fff;
  }
  
  .size-table {
    background: #f6f6f6;
    border-radius: 0.8rem;
    border: 1px solid #2b2b2b;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .size-table table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .size-table th {
    background: #f6f6f6;
    padding: 1.5rem;
    text-align: left;
    font-size: 1.2rem;
    font-weight: 600;
    color: #000;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid #2b2b2b;
  }
  
  .size-table td {
    padding: 1.5rem;
    font-size: 1.4rem;
    color: #666;
    border-bottom: 1px solid #000;
  }
  
  .size-table tr:last-child td {
    border-bottom: none;
  }
  
  .size-table tr:nth-child(even) {
    background: rgba(246, 246, 246, 0.5);
  }
  
  .size-table td:first-child {
    font-weight: 600;
    color: #000;
  }
  
  @media (max-width: 768px) {
    .size-guide-hero {
      padding: 6rem 0 4rem;
    }
    
    .size-guide-hero__features {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    
    .size-guide-nav__list {
      gap: 1rem;
    }
    
    .size-guide-nav__item {
      padding: 0.8rem 1.5rem;
      font-size: 1.4rem;
    }
    
    .size-guide-content {
      padding: 4rem 1.5rem;
    }
    
    .size-chart-controls {
      flex-direction: column;
      align-items: stretch;
    }
    
    .size-table {
      font-size: 1.2rem;
    }
    
    .size-table th,
    .size-table td {
      padding: 1rem;
    }
  }
{%- endstyle -%}

<div class="size-guide-page">
  <!-- Hero Section -->
  <div class="size-guide-hero">
    <div class="bg-grid-pattern"></div>
    <div class="size-guide-hero__content">
      <h1 class="size-guide-hero__title">Complete Size Guide for<br>Jackets & Outerwear</h1>
      <p class="size-guide-hero__description">Find your perfect fit with our comprehensive sizing guide</p>
      
      <div class="size-guide-hero__features">
        <div class="size-guide-hero__feature">
          <div class="size-guide-hero__feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 6H3"/>
              <path d="M10 12H3"/>
              <path d="M10 18H3"/>
              <circle cx="17" cy="12" r="3"/>
              <path d="M17 9v6"/>
            </svg>
          </div>
          <span class="size-guide-hero__feature-text">Accurate Sizing</span>
        </div>
        
        <div class="size-guide-hero__feature">
          <div class="size-guide-hero__feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <span class="size-guide-hero__feature-text">All Body Types</span>
        </div>
        
        <div class="size-guide-hero__feature">
          <div class="size-guide-hero__feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 12l2 2 4-4"/>
              <circle cx="12" cy="12" r="10"/>
            </svg>
          </div>
          <span class="size-guide-hero__feature-text">Perfect Fit</span>
        </div>
        
        <div class="size-guide-hero__feature">
          <div class="size-guide-hero__feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <span class="size-guide-hero__feature-text">Easy Guide</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <div class="size-guide-nav" id="size-guide-nav">
    <div class="size-guide-nav__content">
      <nav class="size-guide-nav__list">
        <a href="#size-charts" class="size-guide-nav__item size-guide-nav__item--active">Size Charts</a>
        <a href="#measurement-guide" class="size-guide-nav__item">How to Measure</a>
        <a href="#size-conversion" class="size-guide-nav__item">Size Conversion</a>
        <a href="#fit-guide" class="size-guide-nav__item">Fit Guide</a>
        <a href="#interactive-model" class="size-guide-nav__item">Interactive Model</a>
        <a href="#faq" class="size-guide-nav__item">FAQ</a>
      </nav>
      <div class="size-guide-progress">
        <div class="size-guide-progress__bar" id="progress-bar"></div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="size-guide-content">
    <!-- Size Charts Section -->
    <section id="size-charts" class="size-guide-section">
      <h2 class="size-guide-section__title">Size Charts</h2>
      <p class="size-guide-section__description">Find the perfect size for all our products with our detailed size charts.</p>
      
      <div class="size-chart-controls">
        <div class="size-chart-tabs">
          <button class="size-chart-tab size-chart-tab--active" data-category="mens">Men's Clothing</button>
          <button class="size-chart-tab" data-category="womens">Women's Clothing</button>
          <button class="size-chart-tab" data-category="kids">Kids' Clothing</button>
          <button class="size-chart-tab" data-category="shoes">Footwear</button>
          <button class="size-chart-tab" data-category="accessories">Accessories</button>
        </div>
        
        <div class="unit-toggle">
          <button class="unit-toggle__button unit-toggle__button--active" data-unit="in">Inches</button>
          <button class="unit-toggle__button" data-unit="cm">Centimeters</button>
        </div>
      </div>
      
      <div class="size-table" id="size-table">
        <table>
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest (in)</th>
              <th>Waist (in)</th>
              <th>Hips (in)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>XS</td><td>34-36</td><td>28-30</td><td>34-36</td></tr>
            <tr><td>S</td><td>36-38</td><td>30-32</td><td>36-38</td></tr>
            <tr><td>M</td><td>38-40</td><td>32-34</td><td>38-40</td></tr>
            <tr><td>L</td><td>40-42</td><td>34-36</td><td>40-42</td></tr>
            <tr><td>XL</td><td>42-44</td><td>36-38</td><td>42-44</td></tr>
            <tr><td>XXL</td><td>44-46</td><td>38-40</td><td>44-46</td></tr>
          </tbody>
        </table>
      </div>
      
      <p style="margin-top: 2rem; font-size: 1.4rem; color: #666;">
        Note: These measurements are body measurements, not garment measurements. For a more relaxed fit, we recommend sizing up.
      </p>
    </section>

    <!-- Measurement Guide Section -->
    <section id="measurement-guide" class="size-guide-section">
      <h2 class="size-guide-section__title">How to Measure</h2>
      <p class="size-guide-section__description">Follow these simple steps to take accurate measurements for the perfect fit.</p>
      
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 4rem; margin-bottom: 4rem;">
        <div style="background: #fff; border: 1px solid #2b2b2b; border-radius: 0.8rem; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
          <div style="aspect-ratio: 16/9; background: #f6f6f6; display: flex; align-items: center; justify-content: center; color: #666;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <div style="padding: 2rem;">
            <h3 style="font-size: 2rem; font-weight: 600; color: #333; margin-bottom: 1rem;">Chest / Bust</h3>
            <p style="color: #666; line-height: 1.6;">Measure around the fullest part of your chest/bust, keeping the measuring tape horizontal and not too tight.</p>
          </div>
        </div>
        
        <div style="background: #fff; border: 1px solid #2b2b2b; border-radius: 0.8rem; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
          <div style="aspect-ratio: 16/9; background: #f6f6f6; display: flex; align-items: center; justify-content: center; color: #666;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <div style="padding: 2rem;">
            <h3 style="font-size: 2rem; font-weight: 600; color: #333; margin-bottom: 1rem;">Waist</h3>
            <p style="color: #666; line-height: 1.6;">Measure around your natural waistline, which is the narrowest part of your torso, typically above your belly button.</p>
          </div>
        </div>
        
        <div style="background: #fff; border: 1px solid #2b2b2b; border-radius: 0.8rem; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
          <div style="aspect-ratio: 16/9; background: #f6f6f6; display: flex; align-items: center; justify-content: center; color: #666;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
            </svg>
          </div>
          <div style="padding: 2rem;">
            <h3 style="font-size: 2rem; font-weight: 600; color: #333; margin-bottom: 1rem;">Hips</h3>
            <p style="color: #666; line-height: 1.6;">Measure around the fullest part of your hips, usually about 8 inches below your waistline.</p>
          </div>
        </div>
        
        <div style="background: #fff; border: 1px solid #2b2b2b; border-radius: 0.8rem; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
          <div style="aspect-ratio: 16/9; background: #f6f6f6; display: flex; align-items: center; justify-content: center; color: #666;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 6H3"/>
              <path d="M10 12H3"/>
              <path d="M10 18H3"/>
            </svg>
          </div>
          <div style="padding: 2rem;">
            <h3 style="font-size: 2rem; font-weight: 600; color: #333; margin-bottom: 1rem;">Inseam</h3>
            <p style="color: #666; line-height: 1.6;">Measure from the crotch seam to the bottom of the leg along the inside of the leg.</p>
          </div>
        </div>
      </div>
      
      <div style="background: #fff; border: 1px solid #2b2b2b; border-radius: 0.8rem; padding: 3rem;">
        <h3 style="font-family: avertaDefault, 'avertaDefault Fallback', Arial, Helvetica, sans-serif; font-size: 2rem; font-weight: 600; color: #333; margin-bottom: 2rem; letter-spacing: 0;">Measurement Tips</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <li style="display: flex; align-items: flex-start; margin-bottom: 1rem;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #666;">Use a soft measuring tape, not a metal one.</span></li>
          <li style="display: flex; align-items: flex-start; margin-bottom: 1rem;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #666;">Wear minimal clothing or measure directly against your skin.</span></li>
          <li style="display: flex; align-items: flex-start; margin-bottom: 1rem;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #666;">Stand straight with feet together when taking measurements.</span></li>
          <li style="display: flex; align-items: flex-start; margin-bottom: 1rem;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #666;">Keep the measuring tape snug but not tight.</span></li>
          <li style="display: flex; align-items: flex-start; margin-bottom: 1rem;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #666;">Have someone help you for more accurate measurements.</span></li>
          <li style="display: flex; align-items: flex-start;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #666;">Measure twice to ensure accuracy.</span></li>
        </ul>
      </div>
    </section>

    <!-- Size Conversion Section -->
    <section id="size-conversion" class="size-guide-section">
      <h2 class="size-guide-section__title">Size Conversion</h2>
      <p class="size-guide-section__description">Convert between different international sizing systems to find your perfect fit.</p>
      
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 3rem;">
        <button class="size-chart-tab size-chart-tab--active" data-conversion="clothing">Clothing</button>
        <button class="size-chart-tab" data-conversion="shoes">Shoes</button>
        <button class="size-chart-tab" data-conversion="accessories">Accessories</button>
      </div>
      
      <div class="size-table" id="conversion-table">
        <table>
          <thead>
            <tr>
              <th>US</th>
              <th>UK</th>
              <th>EU</th>
              <th>International</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>XS</td><td>6</td><td>34</td><td>XXS</td></tr>
            <tr><td>S</td><td>8</td><td>36</td><td>XS</td></tr>
            <tr><td>M</td><td>10</td><td>38</td><td>S</td></tr>
            <tr><td>L</td><td>12</td><td>40</td><td>M</td></tr>
            <tr><td>XL</td><td>14</td><td>42</td><td>L</td></tr>
            <tr><td>XXL</td><td>16</td><td>44</td><td>XL</td></tr>
          </tbody>
        </table>
      </div>
      
      <div style="background: #fff; border: 1px solid #2b2b2b; border-radius: 0.8rem; padding: 3rem; margin-top: 3rem;">
        <h3 style="font-family: avertaDefault, 'avertaDefault Fallback', Arial, Helvetica, sans-serif; font-size: 2rem; font-weight: 600; color: #2b2b2b; margin-bottom: 2rem; letter-spacing: 0;">Size Conversion Tips</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <li style="display: flex; align-items: flex-start; margin-bottom: 1rem;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #000;">Sizes can vary between brands, so always check the specific brand's size chart when available.</span></li>
          <li style="display: flex; align-items: flex-start; margin-bottom: 1rem;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #000;">When in doubt, go with your measurements rather than your usual size.</span></li>
          <li style="display: flex; align-items: flex-start;"><span style="color: #2b2b2b; margin-right: 1rem;">•</span><span style="color: #000;">European sizes tend to run smaller than US sizes, so you may need to size up.</span></li>
        </ul>
      </div>
    </section>

    <!-- Fit Guide Section -->
    <section id="fit-guide" class="size-guide-section">
      <h2 class="size-guide-section__title">Fit Guide</h2>
      <p class="size-guide-section__description">Understand the different fits we offer to find the style that suits you best.</p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(45rem, 1fr)); gap: 3rem; margin-bottom: 3rem;">
        <div style="background: #fff; border: 1px solid #2b2b2b; border-radius: 0.8rem; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
          <div style="display: flex;">
            <div style="width: 33.333%;">
              <div style="aspect-ratio: 2/3; background: #f6f6f6; display: flex; align-items: center; justify-content: center; color: #666;">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
              </div>
            </div>
            <div style="width: 66.667%; padding: 2.4rem;">
              <h3 style="font-size: 2rem; font-weight: 600; color: #333; margin-bottom: 1rem;">Slim Fit</h3>
              <p style="color: #666; margin-bottom: 2rem; line-height: 1.6;">Our slim fit is tailored close to the body with a narrower cut through the chest, waist, and hips.</p>
              <div>
                <h4 style="font-weight: 500; margin-bottom: 1rem; color: #333;">Best For:</h4>
                <ul style="list-style: none; padding: 0; margin: 0;">
