<script>
document.addEventListener('DOMContentLoaded', function() {
  // Navigation functionality
  const nav = document.getElementById('size-guide-nav');
  const navItems = document.querySelectorAll('.size-guide-nav__item');
  const progressBar = document.getElementById('progress-bar');
  const sections = document.querySelectorAll('.size-guide-section');
  
  // Scroll progress
  function updateProgress() {
    const scrollTop = window.pageYOffset;
    const docHeight = document.body.scrollHeight - window.innerHeight;
    const scrollPercent = (scrollTop / docHeight) * 100;
    progressBar.style.width = scrollPercent + '%';
    
    // Add scrolled class to nav
    if (scrollTop > 300) {
      nav.classList.add('size-guide-nav--scrolled');
    } else {
      nav.classList.remove('size-guide-nav--scrolled');
    }
  }
  
  // Active section tracking
  function updateActiveSection() {
    let current = '';
    sections.forEach(section => {
      const sectionTop = section.getBoundingClientRect().top;
      if (sectionTop < 200) {
        current = section.id;
      }
    });
    
    navItems.forEach(item => {
      item.classList.remove('size-guide-nav__item--active');
      if (item.getAttribute('href') === '#' + current) {
        item.classList.add('size-guide-nav__item--active');
      }
    });
  }
  
  // Smooth scroll
  navItems.forEach(item => {
    item.addEventListener('click', function(e) {
      e.preventDefault();
      const targetId = this.getAttribute('href').substring(1);
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        const yOffset = -100;
        const y = targetElement.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    });
  });
  
  // Size chart functionality
  const chartTabs = document.querySelectorAll('.size-chart-tab');
  const unitButtons = document.querySelectorAll('.unit-toggle__button');
  const sizeTable = document.getElementById('size-table');
  
  let currentCategory = 'mens';
  let currentUnit = 'in';
  
  // Size data
  const sizeData = {
    mens: {
      headers: ['Size', 'Chest', 'Waist', 'Hips'],
      data: [
        ['XS', '34-36', '28-30', '34-36'],
        ['S', '36-38', '30-32', '36-38'],
        ['M', '38-40', '32-34', '38-40'],
        ['L', '40-42', '34-36', '40-42'],
        ['XL', '42-44', '36-38', '42-44'],
        ['XXL', '44-46', '38-40', '44-46']
      ]
    },
    womens: {
      headers: ['Size', 'Bust', 'Waist', 'Hips'],
      data: [
        ['XS', '32-33', '24-25', '34-35'],
        ['S', '34-35', '26-27', '36-37'],
        ['M', '36-37', '28-29', '38-39'],
        ['L', '38-40', '30-32', '40-42'],
        ['XL', '41-43', '33-35', '43-45'],
        ['XXL', '44-46', '36-38', '46-48']
      ]
    },
    kids: {
      headers: ['Size', 'Height', 'Weight', 'Chest'],
      data: [
        ['2T', '33-35', '28-32 lbs', '21'],
        ['3T', '35-38', '32-35 lbs', '22'],
        ['4T', '38-41', '35-39 lbs', '23'],
        ['5', '41-44', '39-45 lbs', '24'],
        ['6', '44-47', '45-50 lbs', '25'],
        ['7', '47-50', '50-59 lbs', '26']
      ]
    },
    shoes: {
      headers: ['US', 'UK', 'EU', 'JP', 'CM'],
      data: [
        ['6', '5', '39', '24', '23.5'],
        ['7', '6', '40', '25', '24.5'],
        ['8', '7', '41', '26', '25.5'],
        ['9', '8', '42', '27', '26.5'],
        ['10', '9', '43', '28', '27.5'],
        ['11', '10', '44', '29', '28.5'],
        ['12', '11', '45', '30', '29.5']
      ]
    },
    accessories: {
      headers: ['Type', 'Size', 'Measurement'],
      data: [
        ['Belts', 'S', '30-32'],
        ['Belts', 'M', '34-36'],
        ['Belts', 'L', '38-40'],
        ['Gloves', 'S', '7-7.5'],
        ['Gloves', 'M', '8-8.5'],
        ['Gloves', 'L', '9-9.5'],
        ['Hats', 'S', '21-21.5'],
        ['Hats', 'M', '22-22.5'],
        ['Hats', 'L', '23-23.5']
      ]
    }
  };
  
  function convertMeasurement(value, fromUnit, toUnit) {
    if (fromUnit === toUnit) return value;
    if (fromUnit === 'in' && toUnit === 'cm') {
      return Math.round(parseFloat(value) * 2.54);
    }
    if (fromUnit === 'cm' && toUnit === 'in') {
      return Math.round(parseFloat(value) / 2.54);
    }
    return value;
  }
  
  function convertMeasurementRange(range, fromUnit, toUnit) {
    if (!range || !range.includes('-')) return range;
    const parts = range.split('-');
    const converted = parts.map(part => convertMeasurement(part.trim(), fromUnit, toUnit));
    return converted.join('-');
  }
  
  function updateSizeTable() {
    const data = sizeData[currentCategory];
    const headers = data.headers.map(header => {
      if (header === 'Chest' || header === 'Waist' || header === 'Hips' || header === 'Bust' || header === 'Height' || header === 'Measurement') {
        return `${header} (${currentUnit})`;
      }
      return header;
    });
    
    let tableHTML = '<table><thead><tr>';
    headers.forEach(header => {
      tableHTML += `<th>${header}</th>`;
    });
    tableHTML += '</tr></thead><tbody>';
    
    data.data.forEach(row => {
      tableHTML += '<tr>';
      row.forEach((cell, index) => {
        let convertedCell = cell;
        // Convert measurements for specific columns
        if (currentCategory === 'mens' && (index === 1 || index === 2 || index === 3)) {
