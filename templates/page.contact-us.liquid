---
layout: theme
---

{%- style -%}
  .contact-page {
    background: #fff;
    padding-bottom: 8rem;
  }
  
  .contact-hero {
    position: relative;
    overflow: hidden;
    background: #fff;
  }
  
  .contact-hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    background-image: linear-gradient(to right, #e5e7eb 1px, transparent 1px), linear-gradient(to bottom, #e5e7eb 1px, transparent 1px);
    background-size: 40px 40px;
    width: 100%;
    height: 100%;
  }
  
  .contact-hero__content {
    position: relative;
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 2rem;
    padding-top: 8rem;
    padding-bottom: 12rem;
    text-align: center;
  }
  
  .contact-hero__title {
    font-size: clamp(4rem, 5vw, 6rem);
    font-weight: 700;
    color: #000;
    margin-bottom: 2rem;
  }
  
  .contact-hero__description {
    font-size: clamp(1.8rem, 2vw, 2rem);
    color: #333;
    margin-bottom: 3rem;
  }
  
  .contact-hero__features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 60rem;
    margin: 0 auto;
  }
  
  .contact-hero__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .contact-hero__feature-icon {
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 50%;
    background: #eaeaea;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .contact-hero__feature-icon svg {
    width: 2.8rem;
    height: 2.8rem;
    color: #2b2b2b;
  }
  
  .contact-hero__feature-text {
    font-weight: 500;
    color: #333;
  }
  
  .contact-content {
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 2rem;
    padding-top: 8rem;
    padding-bottom: 12rem;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
  }
  
  .contact-info__title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 4rem;
  }
  
  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  
  .contact-method {
    display: flex;
    align-items: flex-start;
  }
  
  .contact-method__icon {
    background: #eaeaea;
    padding: 1.2rem;
    border-radius: 50%;
    margin-right: 2rem;
    flex-shrink: 0;
  }
  
  .contact-method__icon svg {
    width: 2.4rem;
    height: 2.4rem;
    color: #2b2b2b;
  }
  
  .contact-method__content h3 {
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .contact-method__content p {
    color: #666;
    margin-bottom: 0.5rem;
  }
  
  .contact-method__content a {
    color: #666;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .contact-method__content a:hover {
    color: #2b2b2b;
  }
  
  .contact-method__content .hours-link {
    color: #2b2b2b;
  }
  
  .contact-method__content .hours-link:hover {
    text-decoration: underline;
  }
  
  .social-section {
    margin-top: 6rem;
  }
  
  .social-section h3 {
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }
  
  .social-links {
    display: flex;
    gap: 2rem;
  }
  
  .social-link {
    background: #f6f6f6;
    padding: 1.2rem;
    border-radius: 50%;
    transition: background-color 0.2s ease;
    text-decoration: none;
  }
  
  .social-link:hover {
    background: #eaeaea;
  }
  
  .social-link svg {
    width: 2.4rem;
    height: 2.4rem;
    color: #2b2b2b;
  }
  
  .contact-form {
    background: #fff;
    padding: 4rem;
    border: 1px solid #000;
    border-bottom: 2px solid #000;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  
  .contact-form__title {
    font-size: 3rem;
    color: #2b2b2b;
    font-weight: 700;
    margin-bottom: 3rem;
  }
  
  .contact-form__description {
    color: #000;
    margin-bottom: 4rem;
  }
  
  .form-group {
    margin-bottom: 3rem;
  }
  
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  
  .form-group label {
    display: block;
    font-size: 1.4rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }
  
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.5rem 2rem;
    border: 1px solid #ddd;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 1.6rem;
  }
  
  .form-group textarea {
    resize: none;
    min-height: 12rem;
  }
  
  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  
  .checkbox-group input[type="checkbox"] {
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.2rem;
  }
  
  .checkbox-group label {
    font-size: 1.4rem;
    color: #666;
    margin-bottom: 0;
  }
  
  .checkbox-group a {
    color: #2b2b2b;
    text-decoration: none;
  }
  
  .checkbox-group a:hover {
    text-decoration: underline;
  }
  
  .submit-btn {
    width: 100%;
    padding: 1.5rem 3rem;
    background: #eaeaea;
    color: #000;
    border: none;
    font-size: 1.6rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  
  .submit-btn:hover {
    background: rgba(234, 234, 234, 0.9);
  }
  
  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  
  .form-message {
    padding: 2rem;
    border-radius: 0.5rem;
    margin-bottom: 3rem;
  }
  
  .form-message--success {
    background: #f0f9ff;
    border: 1px solid #bfdbfe;
    color: #166534;
  }
  
  .form-message--error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
  }
  
  .support-section {
    background: #eaeaea;
    padding: 8rem 0;
  }
  
  .support-content {
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 2rem;
  }
  
  .support-header {
    text-align: center;
    margin-bottom: 6rem;
  }
  
  .support-header h2 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }
  
  .support-header p {
    color: #666;
    max-width: 40rem;
    margin: 0 auto;
  }
  
  .support-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
  }
  
  .support-feature {
    background: #fff;
    padding: 4rem;
    border-radius: 1rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    text-align: center;
  }
  
  .support-feature__icon {
    width: 6.4rem;
    height: 6.4rem;
    background: #eaeaea;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 3rem;
  }
  
  .support-feature__icon svg {
    width: 3.2rem;
    height: 3.2rem;
    color: #2b2b2b;
  }
  
  .support-feature h4 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
  
  .support-feature p {
    color: #666;
    margin-bottom: 2rem;
  }
  
  .support-feature__metric {
    font-size: 1.4rem;
    font-weight: 500;
  }
  
  .support-feature__metric-value {
    color: #2b2b2b;
  }
  
  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    
    .support-features {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
  
  @media (max-width: 768px) {
    .contact-hero__features {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    
    .contact-content {
      padding-top: 4rem;
      padding-bottom: 6rem;
    }
    
    .contact-form {
      padding: 2rem;
    }
    
    .form-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .social-links {
      gap: 1rem;
    }
    
    .support-section {
      padding: 4rem 0;
    }
    
    .support-feature {
      padding: 2rem;
    }
  }
{%- endstyle -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Us - Fineyst",
  "description": "Get in touch with our team for any questions, feedback, or support.",
  "url": "{{ shop.secure_url }}{{ page.url }}"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Fineyst Jackets",
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+1 (888) 840-0885",
      "contactType": "customer service",
      "email": "info@fineystjackets.com",
      "availableLanguage": "English",
      "hoursAvailable": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      }
    }
  ]
}
</script>

