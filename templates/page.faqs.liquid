---
layout: theme
---

{%- style -%}
    .faq-page {
    min-height: 100vh;
    background: #fff;
  }

  .faq-hero {
    background: #eaeaea;
    padding: 12rem 0 8rem;
    margin-bottom: 4rem;
    border-bottom: 1px solid #000;
  }

  .faq-hero__content {
    max-width: 120rem;
    margin: 0 auto;
    text-align: center;
  }

  .faq-hero__title {
    font-family: avertaDefault, "avertaDefault Fallback", Arial, Helvetica, sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: 48px;
    letter-spacing: 0em;
    line-height: 48px;
    margin-bottom: 3rem;
    color: #171717;
  }

  .faq-hero__subtitle {
    font-size: 2rem;
    color: #000;
    max-width: 40rem;
    margin: 0 auto;
  }

  .faq-content {
    max-width: 120rem;
    margin: 0 auto 6rem;
    padding: 0 2rem;
  }

  .faq-search {
    position: relative;
    margin-bottom: 4rem;
  }

  .faq-search__icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #000;
    width: 1.6rem;
    height: 1.6rem;
  }

  .faq-search__input {
    width: 100%;
    padding: 1.5rem 1.5rem 1.5rem 5rem;
    border: 1px solid #ddd;
    border-radius: 0.5rem;
    font-size: 1.6rem;
    background: #fff;
    text-indent: 2rem;
  }

  .faq-search__input:focus {
    outline: none;
    border-color: #000;
  }

  .faq-categories {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    padding-bottom: 1rem;
    margin-bottom: 4rem;
  }

  .faq-categories__list {
    display: flex;
    gap: 1.5rem;
  }

  .faq-category {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 2rem;
    border-radius: 0.8rem;
    min-width: 10rem;
    background: #eaeaea;
    color: #000;
    border: 1px solid #000;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .faq-category:hover,
  .faq-category--active {
    background: #2b2b2b;
    color: #fff;
  }

  .faq-category__icon {
    margin-bottom: 1rem;
    width: 2rem;
    height: 2rem;
  }

  .faq-category__label {
    font-size: 1.4rem;
    font-weight: 500;
  }

  .faq-section__title {
    font-family: avertaDefault, "avertaDefault Fallback", Arial, Helvetica, sans-serif;
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 4rem;
    color: #171717;
    letter-spacing: 0;
  }

  .faq-group {
    margin-bottom: 6rem;
  }

  .faq-group__title {
    font-family: avertaDefault, "avertaDefault Fallback", Arial, Helvetica, sans-serif;
    font-size: 2.4rem;
    font-weight: 700;
    margin-bottom: 3rem;
    color: #171717;
    letter-spacing: 0;
  }

  .faq-items {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .faq-item {
    position: relative;
    background: #fff;
    border-radius: 0.8rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    border: 1px solid #000;
    overflow: hidden;
  }

  .faq-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #000;
  }

  .faq-item__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 2.5rem;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.6rem;
    font-weight: 500;
    color: #000;
  }

  .faq-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: #f6f6f6;
    color: #000;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .faq-item__icon svg {
    width: 1.6rem;
    height: 1.6rem;
    transition: transform 0.3s ease;
  }

  .faq-item--open .faq-item__icon {
    background: #2b2b2b;
    color: #fff;
  }

  .faq-item--open .faq-item__icon svg {
    transform: rotate(0deg);
  }

  .faq-item__icon svg {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-item--open .faq-item__answer {
    max-height: 50rem;
  }

  .faq-item__answer-content {
    padding: 0 2.5rem 2.5rem;
    color: #666;
    font-size: 1.6rem;
    line-height: 1.6;
  }

  .no-results {
    text-align: center;
    padding: 6rem 0;
  }

  .no-results__title {
    font-family: avertaDefault, "avertaDefault Fallback", Arial, Helvetica, sans-serif;
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: 1rem;
    color: #171717;
    letter-spacing: 0;
  }

  .no-results__text {
    color: #666;
    font-size: 1.6rem;
  }

  @media (max-width: 768px) {
    .faq-hero {
      padding: 8rem 0 6rem;
    }

    .faq-categories__list {
      gap: 1rem;
    }

    .faq-category {
      min-width: 8rem;
      padding: 1.2rem 1.5rem;
    }

    .faq-item__question {
      padding: 2rem;
      font-size: 1.4rem;
    }

    .faq-item__answer-content {
      padding: 0 2rem 2rem;
      font-size: 1.4rem;
    }
  }
{%- endstyle -%}

<div class="faq-page">
  <!-- Hero Section -->
  <div class="faq-hero">
