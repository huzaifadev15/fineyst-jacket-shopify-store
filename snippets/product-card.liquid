<script>
  (function() {
    // Prevent duplicate initialization
    if (window.productCardQuickShopInitialized) {
      return;
    }
    window.productCardQuickShopInitialized = true;

    // Mobile carousel for product cards (like product page)
    function initProductCardCarousel() {
      const carousels = document.querySelectorAll('[data-product-card-carousel]');
      // Only initialize if carousels exist (they're only created on mobile or for products with 2+ images)
      if (carousels.length === 0) return;
      
      carousels.forEach(function(carousel) {
        const track = carousel.querySelector('[data-card-carousel-track]');
        const slides = carousel.querySelectorAll('[data-card-carousel-slide]');
        const card = carousel.closest('.product-card');
        const dots = card ? card.querySelectorAll('[data-card-indicator]') : [];
        
        if (!track || slides.length === 0) return;

        let currentIndex = 0;
        let startX = 0;
        let currentX = 0;
        let isDragging = false;
        let startTranslate = 0;
        let currentTranslate = 0;

        function updateCarousel() {
          // Each slide is 50% of track width, so translate by 50% per slide
          const translateX = -currentIndex * 50;
          track.style.transform = `translateX(${translateX}%)`;

          // Update dots
          console.log('Updating dots, currentIndex:', currentIndex, 'dots count:', dots.length);
          dots.forEach(function(dot, index) {
            if (index === currentIndex) {
              dot.classList.add('product-card__indicator--active');
              console.log('Activating dot', index);
            } else {
              dot.classList.remove('product-card__indicator--active');
              console.log('Deactivating dot', index);
            }
          });
        }

        function goToSlide(index) {
          if (index < 0 || index >= slides.length) return;
          currentIndex = index;
          updateCarousel();
        }

        // Dot navigation
        dots.forEach(function(dot, index) {
          dot.addEventListener('click', function(e) {
            e.stopPropagation();
            goToSlide(index);
          });
        });

        // Touch/swipe support (same as product page)
        function getPositionX(event) {
          return event.touches ? event.touches[0].clientX : event.clientX;
        }

        function touchStart(event) {
          console.log('touchStart called', event.type, event.target);
          // Always start drag tracking, we'll determine if it's a click or drag later
          startX = getPositionX(event);
          isDragging = true;
          startTranslate = -currentIndex * 50; // Each slide is 50% of track
          track.style.transition = 'none';
          console.log('Drag started', { startX, startTranslate, currentIndex, isDragging });
        }

        function touchMove(event) {
          if (!isDragging) {
            console.log('touchMove called but not dragging');
            return;
          }
          event.preventDefault();
          currentX = getPositionX(event);
          const carousel = track.closest('.product-card__carousel');
          const carouselWidth = carousel ? carousel.offsetWidth : track.offsetWidth / 2;
          const deltaX = currentX - startX;
          // Move 50% of track per carousel width moved
          currentTranslate = startTranslate + (deltaX / carouselWidth) * 50;
          
          console.log('Dragging', { 
            currentX, 
            startX, 
            deltaX, 
            carouselWidth, 
            currentTranslate, 
            startTranslate 
          });
          
          // Constrain translation (max 50% per slide, 2 slides = 100% max)
          const minTranslate = -(slides.length - 1) * 50;
          const maxTranslate = 0;
          currentTranslate = Math.max(minTranslate, Math.min(maxTranslate, currentTranslate));
          
          track.style.transform = `translateX(${currentTranslate}%)`;
        }

        function touchEnd() {
          if (!isDragging) {
            console.log('touchEnd called but not dragging');
            return;
          }
          
          const movedBy = currentTranslate - startTranslate;
          const carousel = track.closest('.product-card__carousel');
          const carouselWidth = carousel ? carousel.offsetWidth : track.offsetWidth / 2;
          const threshold = carouselWidth * 0.15; // 15% of carousel width
          const hasMoved = Math.abs(movedBy) > threshold;
          
          console.log('Drag ended', { 
            currentTranslate, 
            startTranslate, 
            currentIndex, 
            movedBy, 
            threshold, 
            hasMoved,
            carouselWidth 
          });
          
          isDragging = false;
          track.style.transition = 'transform 0.3s ease';

          // If there was significant movement, prevent link click and snap to slide
          if (hasMoved) {
            // Prevent link navigation
            const links = track.querySelectorAll('a');
            links.forEach(function(link) {
              link.style.pointerEvents = 'none';
              setTimeout(function() {
                link.style.pointerEvents = '';
              }, 100);
            });
            
            // Snap to appropriate slide
            if (movedBy > 0 && currentIndex > 0) {
              console.log('Snapping to previous slide');
              goToSlide(currentIndex - 1);
            } else if (movedBy < 0 && currentIndex < slides.length - 1) {
              console.log('Snapping to next slide');
              goToSlide(currentIndex + 1);
            } else {
              console.log('At boundary, staying on current slide');
              updateCarousel();
            }
          } else {
            console.log('Movement too small, allowing link click');
            updateCarousel();
          }
        }

        // Track if there was actual drag movement to prevent link clicks
        let hadDragMovement = false;
        
        // Store original touchEnd
        const originalTouchEnd = touchEnd;
        touchEnd = function() {
          const movedBy = currentTranslate - startTranslate;
          const carousel = track.closest('.product-card__carousel');
          const carouselWidth = carousel ? carousel.offsetWidth : track.offsetWidth / 2;
          const threshold = carouselWidth * 0.1; // 10% threshold
          hadDragMovement = Math.abs(movedBy) > threshold;
          console.log('hadDragMovement:', hadDragMovement, 'movedBy:', movedBy);
          originalTouchEnd();
        };
        
        // Prevent link clicks if there was drag movement
        const links = track.querySelectorAll('a');
        links.forEach(function(link) {
          link.addEventListener('click', function(e) {
            if (hadDragMovement) {
              console.log('Preventing link click after drag movement');
              e.preventDefault();
              e.stopPropagation();
              hadDragMovement = false; // Reset for next interaction
              return false;
            }
          }, true); // Use capture phase to catch before link navigation
        });

        // Touch events
        track.addEventListener('touchstart', touchStart, { passive: true });
        track.addEventListener('touchmove', touchMove, { passive: true });
        track.addEventListener('touchend', touchEnd);

        // Mouse events for desktop testing
        track.addEventListener('mousedown', function(e) {
          console.log('mousedown on track');
          // Don't prevent default on mousedown, let touchStart handle it
          touchStart(e);
        });
        
        // Add mousemove to document to track drag outside track
        document.addEventListener('mousemove', function(e) {
          if (isDragging) {
            console.log('mousemove during drag');
            e.preventDefault();
            touchMove(e);
          }
        });
        
        document.addEventListener('mouseup', function(e) {
          if (isDragging) {
            console.log('mouseup ending drag');
            touchEnd();
          }
        });
        
        track.addEventListener('mouseleave', function(e) {
          if (isDragging) {
            console.log('mouseleave ending drag');
            touchEnd();
          }
        });
        
        // Prevent image drag
        const images = track.querySelectorAll('img');
        images.forEach(function(img) {
          img.addEventListener('dragstart', function(e) {
            e.preventDefault();
          });
        });

        // Initialize
        updateCarousel();
      });
    }

    // Initialize on load and resize
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductCardCarousel);
    } else {
      initProductCardCarousel();
    }

    // Re-initialize on resize (in case of orientation change)
    let resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        initProductCardCarousel();
      }, 250);
    });

    // Quick Add Modal functionality
    function initQuickAddModal() {
      // Move all modals to body on init for proper full-screen display
      document.querySelectorAll('.quick-add-modal').forEach(function(modal) {
        if (modal.parentElement !== document.body) {
          document.body.appendChild(modal);
        }
      });

      // Open modal when cart button is clicked
      document.addEventListener('click', function(e) {
        const trigger = e.target.closest('[data-quick-add-trigger]');
        if (trigger) {
          e.preventDefault();
          e.stopPropagation();
          
          const productId = trigger.getAttribute('data-quick-add-trigger');
          const modal = document.querySelector(`[data-quick-add-modal="${productId}"]`);
          
          if (modal) {
            // Ensure modal is in body
            if (modal.parentElement !== document.body) {
              document.body.appendChild(modal);
            }
            modal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
          }
        }
      });

      // Close modal
      document.addEventListener('click', function(e) {
        const closeBtn = e.target.closest('[data-quick-add-close]');
        if (closeBtn) {
          const modal = closeBtn.closest('.quick-add-modal');
          if (modal) {
            modal.classList.remove('is-open');
            document.body.style.overflow = '';
            
            // Reset selection
            const radios = modal.querySelectorAll('input[type="radio"]');
            radios.forEach(function(radio) {
              radio.checked = false;
            });
          }
        }
      });

      // Handle add to cart from modal
      document.addEventListener('click', function(e) {
        const submitBtn = e.target.closest('[data-quick-add-submit]');
        if (!submitBtn) return;
        
        e.preventDefault();
        e.stopPropagation();
        
        const productId = submitBtn.getAttribute('data-quick-add-submit');
        const modal = document.querySelector(`[data-quick-add-modal="${productId}"]`);
        
        if (!modal) return;
        
        // Check if already processing
        if (submitBtn.classList.contains('is-loading')) return;
        
        // Get selected variant
        let variantId = null;
        const selectedRadio = modal.querySelector(`input[name="quick-add-size-${productId}"]:checked`);
        const hiddenVariant = modal.querySelector(`input[name="quick-add-variant-${productId}"]`);
        
        if (selectedRadio) {
          variantId = selectedRadio.value;
        } else if (hiddenVariant) {
          variantId = hiddenVariant.value;
        }
        
        if (!variantId || variantId === 'null' || variantId === '') {
          alert('Please select a size');
          return;
        }
        
        // Show loading state
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'ADDING...';
        submitBtn.classList.add('is-loading');
        submitBtn.disabled = true;
        
        // Add to cart
        const data = {
          items: [{
            id: parseInt(variantId, 10),
            quantity: 1
          }]
        };
        
        const cartUrl = (window.routes && window.routes.cart_add_url) 
          ? window.routes.cart_add_url + '.js' 
          : '/cart/add.js';
        
        fetch(cartUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(data)
        })
        .then(function(response) {
          if (!response.ok) {
            return response.json().then(function(err) {
              throw new Error(err.description || err.message || 'Failed to add to cart');
            });
          }
          return response.json();
        })
        .then(function(cartData) {
          // Close modal
          modal.classList.remove('is-open');
          document.body.style.overflow = '';
          
          // Reset selection
          const radios = modal.querySelectorAll('input[type="radio"]');
          radios.forEach(function(radio) {
            radio.checked = false;
          });
          
          // Trigger cart update
          document.dispatchEvent(new CustomEvent('cart:updated'));
          
          // Update cart count
          if (typeof updateCartCount === 'function') {
            updateCartCount();
          }
          
          // Open cart sidebar
          if (typeof openCartSidebar === 'function') {
            openCartSidebar();
          } else {
            const cartSidebar = document.querySelector('[data-cart-sidebar]');
            if (cartSidebar) {
              cartSidebar.classList.add('is-open');
              document.body.style.overflow = 'hidden';
            }
          }
          
          // Reload cart sidebar
          if (typeof loadCartSidebar === 'function') {
            loadCartSidebar();
          }
        })
        .catch(function(error) {
          console.error('Error adding to cart:', error);
          alert(error.message || 'Failed to add to cart. Please try again.');
        })
        .finally(function() {
          // Reset button
          submitBtn.textContent = originalText;
          submitBtn.classList.remove('is-loading');
          submitBtn.disabled = false;
        });
      });
    }

    // Initialize quick add modal
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initQuickAddModal);
    } else {
      initQuickAddModal();
    }
    
    // Color Picker Modal functionality
    function initColorPickerModal() {
      // Open color picker modal
      document.addEventListener('click', function(e) {
        const trigger = e.target.closest('[data-color-picker-trigger]');
        if (trigger) {
          e.preventDefault();
          e.stopPropagation();
          
          const productId = trigger.getAttribute('data-color-picker-trigger');
          const modal = document.querySelector(`[data-color-picker-modal="${productId}"]`);
          
          if (modal) {
            // Move modal to body if not already there
            if (modal.parentElement !== document.body) {
              document.body.appendChild(modal);
            }
            modal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
          }
        }
      });
      
      // Close color picker modal
      document.addEventListener('click', function(e) {
        const closeBtn = e.target.closest('[data-color-picker-close]');
        if (closeBtn) {
          const modal = closeBtn.closest('.color-picker-modal');
          if (modal) {
            modal.classList.remove('is-open');
            document.body.style.overflow = '';
          }
        }
      });
      
      // Handle color selection
      document.addEventListener('click', function(e) {
        const colorBtn = e.target.closest('.color-picker-modal__color');
        if (colorBtn) {
          const color = colorBtn.getAttribute('data-color');
          const modal = colorBtn.closest('.color-picker-modal');
          
          if (modal && color) {
            // Close modal
            modal.classList.remove('is-open');
            document.body.style.overflow = '';
            
            // Redirect to color-specific product (you can customize this logic)
            const colorHandle = color.toLowerCase().replace(/\s+/g, '-');
            const currentUrl = window.location.pathname;
            const newUrl = currentUrl.replace(/-(black|brown|grey|red)-/, `-${colorHandle}-`);
            
            if (newUrl !== currentUrl) {
              window.location.href = newUrl;
            }
          }
        }
      });
    }
    
    // Initialize color picker modal
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initColorPickerModal);
    } else {
      initColorPickerModal();
    }
    
    // Use event delegation to handle clicks on all size buttons
    document.addEventListener('click', function(e) {
      const button = e.target.closest('.product-card__size-button:not(:disabled)');
      if (!button) return;
      
      e.preventDefault();
      e.stopPropagation();
      
      // Check if button is already processing
      if (button.hasAttribute('data-adding-to-cart')) {
        return;
      }
      
      const variantId = button.getAttribute('data-variant-id');
      const productId = button.getAttribute('data-product-id');
      
      if (!variantId || !productId) {
        return;
      }
      
      // Get original text
      if (!button.getAttribute('data-original-text')) {
        button.setAttribute('data-original-text', button.textContent.trim());
      }
      const originalText = button.getAttribute('data-original-text');
      
      // Validate variant ID
      if (variantId === 'undefined' || variantId === 'null' || variantId === '') {
        console.error('Invalid variant ID:', variantId);
        return;
      }
      
      // Convert variant ID to number if it's a string
      const numericVariantId = typeof variantId === 'string' ? parseInt(variantId, 10) : variantId;
      
      if (isNaN(numericVariantId) || numericVariantId <= 0) {
        console.error('Variant ID is not a valid number:', variantId);
        return;
      }
      
      // Mark button as processing
      button.setAttribute('data-adding-to-cart', 'true');
      button.disabled = true;
      button.style.opacity = '0.6';
      button.style.pointerEvents = 'none';
      button.textContent = 'Adding...';
            
            const data = {
              items: [{
                id: numericVariantId,
                quantity: 1
              }]
            };
            
            // Use cart_add_url if available, otherwise fallback to /cart/add.js
            const cartUrl = (window.routes && window.routes.cart_add_url) 
              ? window.routes.cart_add_url + '.js' 
              : '/cart/add.js';
            
            fetch(cartUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(data)
            })
            .then(response => {
              // Check if response is ok
              if (!response.ok) {
                // Handle specific error cases
                if (response.status === 422) {
                  // Item already in cart or max quantity reached
                  return response.json().then(errorData => {
                    // Return error object instead of showing alert immediately
                    return {
                      error: true,
                      status: 422,
                      message: errorData.description || errorData.message || 'This item is already in your cart at maximum quantity.'
                    };
                  }).catch(() => {
                    return {
                      error: true,
                      status: 422,
                      message: 'This item is already in your cart at maximum quantity.'
                    };
                  });
                }
                
                // Try to get error message from response
                return response.text().then(text => {
                  let errorMessage = 'Failed to add item to cart';
                  try {
                    const errorData = JSON.parse(text);
                    errorMessage = errorData.description || errorData.message || errorMessage;
                  } catch (e) {
                    // If response isn't JSON, use status text
                    errorMessage = `Failed to add item to cart (${response.status})`;
                  }
                  return {
                    error: true,
                    status: response.status,
                    message: errorMessage
                  };
                });
              }
              // Success - return cart data
              return response.json().then(cartData => {
                return {
                  error: false,
                  data: cartData
                };
              });
            })
            .then(result => {
              // Handle result
              if (result.error) {
                // This is an error case
                // Open cart sidebar to show current cart state
                if (typeof openCartSidebar === 'function') {
                  openCartSidebar();
                } else {
                  const cartSidebar = document.querySelector('[data-cart-sidebar]');
                  if (cartSidebar) {
                    cartSidebar.classList.add('is-open');
                    document.body.style.overflow = 'hidden';
                  }
                }
                
                if (typeof loadCartSidebar === 'function') {
                  loadCartSidebar();
                }
                
                // For 422 (max quantity), don't show alert - cart sidebar is already open
                // For other errors, show error message
                if (result.status !== 422) {
                  alert(result.message);
                }
                
                // Re-enable button
                button.removeAttribute('data-adding-to-cart');
                button.disabled = false;
                button.style.opacity = '1';
                button.style.pointerEvents = '';
                button.textContent = originalText;
                return;
              }
              
              // Success case - no alerts, just update UI
              const cartData = result.data;
              
              // Validate cart data
              if (!cartData) {
                console.error('Invalid cart data received');
                button.removeAttribute('data-adding-to-cart');
                button.disabled = false;
                button.style.opacity = '1';
                button.style.pointerEvents = '';
                button.textContent = originalText;
                return;
              }
              
              // Trigger cart update event
              document.dispatchEvent(new CustomEvent('cart:updated'));
              
              // Update cart count if function exists
              if (typeof updateCartCount === 'function') {
                updateCartCount();
              }
              
              // Open cart sidebar and render items
              if (typeof openCartSidebar === 'function') {
                openCartSidebar();
              } else {
                // Fallback: manually open sidebar
                const cartSidebar = document.querySelector('[data-cart-sidebar]');
                if (cartSidebar) {
                  cartSidebar.classList.add('is-open');
                  document.body.style.overflow = 'hidden';
                }
              }
              
              // Render cart items if function exists
              if (typeof renderCartItems === 'function' && cartData && cartData.items && Array.isArray(cartData.items)) {
                renderCartItems(cartData);
                if (typeof updateCartSubtotal === 'function') {
                  updateCartSubtotal(cartData);
                }
              } else if (typeof loadCartSidebar === 'function') {
                setTimeout(function() {
                  loadCartSidebar();
                }, 500);
              }
              
              // Re-enable button
              button.removeAttribute('data-adding-to-cart');
              button.disabled = false;
              button.style.opacity = '1';
              button.style.pointerEvents = '';
              button.textContent = originalText;
            })
            .catch(error => {
              console.error('Error adding to cart:', error);
              
              // Re-enable button on error
              button.removeAttribute('data-adding-to-cart');
              button.disabled = false;
              button.style.opacity = '1';
              button.style.pointerEvents = '';
              button.textContent = originalText;
              
              // Only show alert for actual network/parsing errors
              // Don't show if it's a handled error (422, etc.)
              if (error.message && !error.message.includes('already in cart') && !error.message.includes('maximum quantity')) {
                // Try to load cart anyway to show current state
                if (typeof loadCartSidebar === 'function') {
                  loadCartSidebar();
                }
                if (typeof openCartSidebar === 'function') {
                  openCartSidebar();
                }
                
                alert('Failed to add item to cart. Please try again.');
              }
            });
    });
  })();
</script>


