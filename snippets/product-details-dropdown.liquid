<div class="product-details-dropdown border-b border-gray-200" data-dropdown>
  <button 
    type="button"
    class="product-details-toggle w-full py-3 sm:py-4 px-2 sm:px-0 flex items-center justify-between text-sm font-bold uppercase text-black"
    data-details-toggle
    aria-expanded="false"
  >
    <span>Details</span>
    <svg 
      width="16" 
      height="16" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2" 
      class="chevron-icon text-black transition-transform duration-200"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  
  <div class="product-details-content overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0" data-details-content>
    <div class="pb-3 sm:pb-4 text-sm text-gray-700 leading-relaxed">
      {%- assign first_paragraph = product.description | split: '</p>' | first | append: '</p>' -%}
      {%- assign rest_description = product.description | remove_first: first_paragraph -%}
      
      <div class="product-description">
        {{ first_paragraph }}
      </div>
      
      {%- if rest_description != blank -%}
        <button 
          type="button"
          class="read-more-btn flex items-center justify-center w-full py-2 mt-2 bg-gray-50 hover:bg-gray-100 rounded-md transition-colors"
          data-read-more
        >
          <span class="text-sm font-medium mr-1 text-black">Read more</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-black">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      {%- endif -%}
      
      <ul class="list-disc pl-5 mt-3 sm:mt-4 space-y-1">
        <li>SKU: {{ product.selected_or_first_available_variant.sku | default: 'N/A' }}</li>
        <li>Material: {{ product.metafields.custom.material | default: 'Premium fabric' }}</li>
        <li>Fit: {{ product.metafields.custom.fit | default: 'Regular fit' }}</li>
      </ul>
    </div>
  </div>
</div>

{%- if rest_description != blank -%}
  <!-- Modal for full description -->
  <div class="details-modal fixed inset-0 bg-black bg-opacity-50 z-50 hidden" data-details-modal>
    <div class="modal-content bg-white rounded-lg max-w-2xl mx-auto mt-20 p-6 max-h-96 overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold">Product Details</h3>
        <button type="button" class="text-gray-500 hover:text-gray-700" data-modal-close>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="text-sm text-gray-700 leading-relaxed">
        {{ product.description }}
      </div>
    </div>
  </div>
{%- endif -%}

<style>
.product-details-dropdown {
  border-bottom: 1px solid #e5e7eb;
}

.product-details-toggle {
  width: 100%;
  padding: 0.75rem 0.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #000;
  background: none;
  border: none;
  cursor: pointer;
}

@media (min-width: 640px) {
  .product-details-toggle {
    padding: 1rem 0;
  }
}

.chevron-icon {
  transition: transform 0.2s ease;
}

.product-details-toggle[aria-expanded="true"] .chevron-icon {
  transform: rotate(180deg);
}

.product-details-content {
  overflow: hidden;
  transition: all 0.3s ease-in-out;
  max-height: 0;
  opacity: 0;
}

.product-details-content.active {
  max-height: 24rem;
  opacity: 1;
}

.read-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 0.5rem;
  margin-top: 0.5rem;
  background-color: #f9fafb;
  border-radius: 0.375rem;
  transition: background-color 0.2s ease;
  border: none;
  cursor: pointer;
}

.read-more-btn:hover {
  background-color: #f3f4f6;
}

.details-modal {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 50;
  display: none;
}

.details-modal.active {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 5rem;
}

.modal-content {
  background: white;
  border-radius: 0.5rem;
  max-width: 42rem;
  margin: 0 1rem;
  padding: 1.5rem;
  max-height: 24rem;
  overflow-y: auto;
}

ul {
  list-style-type: disc;
  padding-left: 1.25rem;
  margin-top: 0.75rem;
}

@media (min-width: 640px) {
  ul {
    margin-top: 1rem;
  }
}

ul li {
  margin-bottom: 0.25rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const toggle = document.querySelector('[data-details-toggle]');
  const content = document.querySelector('[data-details-content]');
  const readMoreBtn = document.querySelector('[data-read-more]');
  const modal = document.querySelector('[data-details-modal]');
  const modalClose = document.querySelector('[data-modal-close]');

  if (toggle && content) {
    toggle.addEventListener('click', function() {
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      
      this.setAttribute('aria-expanded', !isExpanded);
      content.classList.toggle('active');
    });
  }

  if (readMoreBtn && modal) {
    readMoreBtn.addEventListener('click', function() {
      modal.classList.add('active');
    });
  }

  if (modalClose && modal) {
    modalClose.addEventListener('click', function() {
      modal.classList.remove('active');
    });

    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });
  }
});
</script>