<div class="cart-sidebar" data-cart-sidebar>
  <!-- Overlay -->
  <div class="cart-sidebar__overlay" data-cart-sidebar-overlay></div>
  
  <!-- Sidebar Content -->
  <div class="cart-sidebar__content">
    <!-- Header -->
    <div class="cart-sidebar__header">
      <h2 class="cart-sidebar__title">MY SHOPPING CART</h2>
      <h2 class="cart-sidebar__title-mobile">Your Shopping Cart</h2>
      <div class="cart-sidebar__header-actions">
        <a href="{{ routes.cart_url }}" class="cart-sidebar__details-link">SEE DETAILS</a>
        <button type="button" class="cart-sidebar__close" data-cart-sidebar-close aria-label="Close cart">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Content Wrapper -->
    <div class="cart-sidebar__scrollable">
      <!-- Success Banner -->
      {% if cart.item_count > 0 %}
      <div class="cart-sidebar__banner" data-cart-sidebar-banner>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span>GOOD CHOICE! Your item was added to the shopping cart.</span>
      </div>
      {% endif %}
      
      <!-- Cart Items -->
      <div class="cart-sidebar__items" data-cart-sidebar-items>
        <!-- Items will be dynamically loaded here -->
      </div>


      <!-- Empty Cart Message -->
      <div class="cart-sidebar__empty" data-cart-sidebar-empty style="display: none;">
        <p>Your cart is empty</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue Shopping</a>
      </div>

      <!-- Order Overview -->
      <div class="cart-sidebar__overview" data-cart-sidebar-overview>
        <h3 class="cart-sidebar__overview-title cart-sidebar__overview-title--desktop">ORDER OVERVIEW</h3>
        <h3 class="cart-sidebar__overview-title cart-sidebar__overview-title--mobile">Order Summary</h3>
        <div class="cart-sidebar__overview-row">
          <span>Subtotal</span>
          <span data-cart-sidebar-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <div class="cart-sidebar__overview-row">
          <span>Shipping</span>
          <span>Free</span>
        </div>
        <div class="cart-sidebar__overview-row">
          <span>Estimated Tax</span>
          <span>$0</span>
        </div>
        <div class="cart-sidebar__overview-row cart-sidebar__overview-row--total">
          <span>Total price</span>
          <span data-cart-sidebar-total>{{ cart.total_price | money }}</span>
        </div>
      </div>
    </div>

    <!-- Delivery Information -->
    <div class="cart-sidebar__delivery">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
      <span class="cart-sidebar__delivery-text" data-delivery-date>Delivery approx. January 05 - January 06</span>
    </div>

    <script>
      // Calculate delivery date (5-6 days from today)
      document.addEventListener('DOMContentLoaded', function() {
        const deliveryElement = document.querySelector('[data-delivery-date]');
        if (deliveryElement) {
          const today = new Date();
          const deliveryStart = new Date(today);
          const deliveryEnd = new Date(today);
          
          deliveryStart.setDate(today.getDate() + 5);
          deliveryEnd.setDate(today.getDate() + 6);
          
          const options = { month: 'long', day: '2-digit' };
          const startDate = deliveryStart.toLocaleDateString('en-US', options);
          const endDate = deliveryEnd.toLocaleDateString('en-US', options);
          
          deliveryElement.textContent = `Delivery approx. ${startDate} - ${endDate}`;
        }
      });
    </script>

    <!-- Checkout Actions -->
    <div class="cart-sidebar__actions">
      <form action="/checkout" method="post" data-cart-sidebar-form>
        <button type="submit" name="checkout" class="btn btn--primary btn--block cart-sidebar__checkout">
          CHECKOUT
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // Voucher toggle functionality
  document.addEventListener('DOMContentLoaded', function() {
    const voucherToggle = document.querySelector('[data-voucher-toggle]');
    const voucherContent = document.querySelector('[data-voucher-content]');
    
    if (voucherToggle && voucherContent) {
      voucherToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const isExpanded = voucherToggle.getAttribute('aria-expanded') === 'true';
        voucherToggle.setAttribute('aria-expanded', !isExpanded);
        voucherContent.style.display = isExpanded ? 'none' : 'block';
        voucherToggle.classList.toggle('is-open', !isExpanded);
      });
    }

    // Voucher apply functionality
    const voucherInput = document.querySelector('[data-cart-sidebar-voucher-input]');
    const voucherApplyBtn = document.querySelector('[data-cart-sidebar-voucher-apply]');
    const voucherMessage = document.querySelector('[data-cart-sidebar-voucher-message]');

    if (voucherInput && voucherApplyBtn) {
      const applyVoucher = function() {
        const code = voucherInput.value.trim();
        if (!code) {
          showVoucherMessage('Please enter a voucher code', 'error');
          return;
        }
        // Redirect to checkout with discount code
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/checkout';
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'discount';
        input.value = code;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      };

      const showVoucherMessage = function(message, type) {
        if (!voucherMessage) return;
        voucherMessage.textContent = message;
        voucherMessage.className = 'cart-sidebar__voucher-message';
        voucherMessage.classList.add('cart-sidebar__voucher-message--' + (type || 'info'));
        voucherMessage.style.display = 'block';
      };

      voucherApplyBtn.addEventListener('click', applyVoucher);
      voucherInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          applyVoucher();
        }
      });
    }

    // Prevent background scroll when scrolling inside cart sidebar
    const scrollableArea = document.querySelector('.cart-sidebar__scrollable');
    if (scrollableArea) {
      scrollableArea.addEventListener('touchmove', function(e) {
        e.stopPropagation();
      }, { passive: true });
      
      // Prevent scroll chaining
      scrollableArea.addEventListener('wheel', function(e) {
        const scrollTop = scrollableArea.scrollTop;
        const scrollHeight = scrollableArea.scrollHeight;
        const clientHeight = scrollableArea.clientHeight;
        
        // At top and scrolling up
        if (scrollTop === 0 && e.deltaY < 0) {
          e.preventDefault();
        }
        // At bottom and scrolling down
        if (scrollTop + clientHeight >= scrollHeight && e.deltaY > 0) {
          e.preventDefault();
        }
      }, { passive: false });
    }reventDefault();
        }
      }, { passive: false });
    }
  });
</script>
