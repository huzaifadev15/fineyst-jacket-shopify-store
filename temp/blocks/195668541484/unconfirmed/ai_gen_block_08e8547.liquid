{% doc %}
  @prompt
    Create a dynamic checkout buttons block that displays express payment options (Apple Pay, Google Pay, PayPal, Shop Pay) below the Add to Cart button on product pages. The buttons should be styled to match Shopify's standard dynamic checkout button appearance and work with the store's configured payment methods including Bogus Gateway for testing.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dynamic-checkout-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin-top: {{ block.settings.spacing_top }}px;
  }

  .ai-dynamic-checkout__wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-dynamic-checkout__buttons-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-dynamic-checkout__buttons-{{ ai_gen_id }} .shopify-payment-button {
    width: 100%;
  }

  .ai-dynamic-checkout__buttons-{{ ai_gen_id }} .shopify-payment-button__button {
    min-height: {{ block.settings.button_height }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-dynamic-checkout__buttons-{{ ai_gen_id }} .shopify-payment-button__button--unbranded {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: 600;
    border: none;
  }

  .ai-dynamic-checkout__buttons-{{ ai_gen_id }} .shopify-payment-button__button--unbranded:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-dynamic-checkout__buttons-{{ ai_gen_id }} .shopify-payment-button__more-options {
    color: {{ block.settings.more_options_color }};
    font-size: {{ block.settings.more_options_font_size }}px;
    margin-top: {{ block.settings.more_options_spacing }}px;
  }

  {% if block.settings.show_separator %}
    .ai-dynamic-checkout__separator-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      text-align: center;
      margin: {{ block.settings.separator_spacing }}px 0;
      color: {{ block.settings.separator_color }};
      font-size: {{ block.settings.separator_font_size }}px;
    }

    .ai-dynamic-checkout__separator-{{ ai_gen_id }}::before,
    .ai-dynamic-checkout__separator-{{ ai_gen_id }}::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid {{ block.settings.separator_line_color }};
    }

    .ai-dynamic-checkout__separator-{{ ai_gen_id }}::before {
      margin-right: 12px;
    }

    .ai-dynamic-checkout__separator-{{ ai_gen_id }}::after {
      margin-left: 12px;
    }
  {% endif %}

  .ai-dynamic-checkout__empty-state-{{ ai_gen_id }} {
    padding: 20px;
    background-color: #f9f9f9;
    border: 1px dashed #cccccc;
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
    color: #666666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-dynamic-checkout__buttons-{{ ai_gen_id }} .shopify-payment-button__button {
      min-height: {{ block.settings.button_height_mobile }}px;
    }
  }
{% endstyle %}

<dynamic-checkout-{{ ai_gen_id }}
  class="ai-dynamic-checkout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-dynamic-checkout__wrapper-{{ ai_gen_id }}">
    {% if block.settings.show_separator %}
      <div class="ai-dynamic-checkout__separator-{{ ai_gen_id }}">
        {{ block.settings.separator_text }}
      </div>
    {% endif %}

    <div class="ai-dynamic-checkout__buttons-{{ ai_gen_id }}">
      {% if product %}
        {{ form | payment_button }}
      {% else %}
        <div class="ai-dynamic-checkout__empty-state-{{ ai_gen_id }}">
          This block displays express checkout buttons (Apple Pay, Google Pay, PayPal, Shop Pay) based on your store's payment settings. Add this block to a product page to see available options.
        </div>
      {% endif %}
    </div>
  </div>
</dynamic-checkout-{{ ai_gen_id }}>

<script>
  (function() {
    class DynamicCheckout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.observePaymentButtons();
      }

      observePaymentButtons() {
        const buttonContainer = this.querySelector('.ai-dynamic-checkout__buttons-{{ ai_gen_id }}');
        if (!buttonContainer) return;

        const observer = new MutationObserver(() => {
          this.stylePaymentButtons();
        });

        observer.observe(buttonContainer, {
          childList: true,
          subtree: true
        });

        this.stylePaymentButtons();
      }

      stylePaymentButtons() {
        const paymentButton = this.querySelector('.shopify-payment-button');
        if (paymentButton) {
          paymentButton.style.width = '100%';
        }
      }
    }

    customElements.define('dynamic-checkout-{{ ai_gen_id }}', DynamicCheckout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Dynamic checkout buttons",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height (desktop)",
      "min": 40,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "button_height_mobile",
      "label": "Button height (mobile)",
      "min": 40,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Unbranded button colors"
    },
    {
      "type": "paragraph",
      "content": "These colors apply to the generic Buy it now button when express payment methods are unavailable"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "More options link"
    },
    {
      "type": "color",
      "id": "more_options_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "more_options_font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "more_options_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator",
      "default": true
    },
    {
      "type": "text",
      "id": "separator_text",
      "label": "Separator text",
      "default": "or"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "separator_line_color",
      "label": "Line color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "separator_font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "separator_spacing",
      "label": "Spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Dynamic checkout buttons"
    }
  ]
}
{% endschema %}